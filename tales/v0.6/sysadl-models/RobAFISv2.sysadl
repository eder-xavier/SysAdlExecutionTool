}

Requirement AvoidZoneNFR ( 2.2.2 ) {
    text = "Must prevent the robot's wheels or tracks from entering the forbidden machine zones by initiating an immediate emergency stop upon boundary detection."
    satisfied by SysADL.Components::DriveSystemCP [
        verified by ValidationPlan_PkgScenarios.Scenario_RoutingLogic_P0_Unit1 ,
        ValidationPlan_PkgScenarios.Scenario_RoutingLogic_P0_Unit2 ,
        ValidationPlan_PkgScenarios.Scenario_RoutingLogic_P1_Unit1 ,
        ValidationPlan_PkgScenarios.Scenario_RoutingLogic_P1_Unit2
    ] ;
    derive SafetyZoneNFR ;
}

Requirement MissionTimeNFR ( 2.3 ) {
    text = "Must be able to complete the nominal sorting and transport mission within a maximum time of 4 minutes."
    satisfied by SysADL.Components::RobAFISSystemCP ;
    derive SystemConstraintsNFR ;
}

Requirement PriorityTimeNFR ( 2.4 ) {
    text = "The RobAFIS system must meet strict execution and travel time budgets for priority SPE operations."
    satisfied by SysADL.Components::RobAFISSystemCP ;
    derive SystemConstraintsNFR ;
}

Requirement PriorityRoutingTimeNFR ( 2.4.1 ) {
    text = "Must be able to process the SPE priority interrupt and calculate the new route within the allocated time budget."
    satisfied by SysADL.Components::CargoHandlerCP [
        verified by ValidationPlan_PkgScenarios.Scenario_PriorityResolution_Unit1 ,
        ValidationPlan_PkgScenarios.Scenario_PriorityResolution_Unit2
    ] ;
    derive PriorityTimeNFR ;
}

Requirement PriorityTravelTimeNFR ( 2.4.2 ) {
    text = "Must be able to transit to the SPE location within the allocated time budget."
    satisfied by SysADL.Components::DriveSystemCP [
        verified by ValidationPlan_PkgScenarios.Scenario_PriorityResolution_Unit1 ,
        ValidationPlan_PkgScenarios.Scenario_PriorityResolution_Unit2
    ] ;
    derive PriorityTimeNFR ;
}

Requirement PriorityExtractionTimeNFR ( 2.4.3 ) {
    text = "Must be able to physically extract the priority piece within the allocated time budget."
    satisfied by SysADL.Components::GrabberCP [
        verified by ValidationPlan_PkgScenarios.Scenario_PriorityResolution_Unit1 ,
        ValidationPlan_PkgScenarios.Scenario_PriorityResolution_Unit2
    ] ;
    derive PriorityTimeNFR ;
}

Requirement AutonomyNFR ( 2.5 ) {
    text = "Must operate completely autonomously without remote control or human intervention after the initial start signal."
    satisfied by SysADL.Components::RobAFISControllerCP ;
    derive SystemConstraintsNFR ;
}


// =========================================================================
// 12. VALIDATION PLAN (Unified package containing Signals, Activities, Scenes & Scenarios)
// =========================================================================
package PkgScenarios {
    import EnvComponentsRobAFIS ;
    import SysADL.types ;

    EnvActivitiesDefinitions RobAFISEnvironmentActivities {
        // Signals
        signal def StartSimulationSig { attributes : mission : MissionParameter ; strategy : StrategyParameter ; }
        signal def SetMissionParamSig { attributes : param : MissionParameter ; strategy : StrategyParameter ; }
        signal def LineOffsetChangedSig { attributes : offset : Int ; }
        signal def ObstacleDetectedSig { }
        signal def ObstacleRemovedSig { }
        signal def ZoneAlarmTriggeredSig { }
        signal def GrabPieceTSig { attributes : pieceColor : PieceColor ; }
        signal def DropPieceSig { }
        signal def LeftPASig { }
        signal def UnitArrivedAtTSig { }
        signal def UnitArrivedAtSPESig { }
        signal def TargetReachedSig { }
        signal def ExposePieceTSig { attributes : pieceColor : PieceColor ; }
        signal def ExposePieceSPESig { attributes : pieceColor : PieceColor ; }
        signal def ExtractedPieceTSig { }
        signal def ExtractedPieceSPESig { }
        signal def RoutedToSASig { }
        signal def RoutedToSPDSig { }
        signal def DetectedGreenPadSig { }
        signal def DetectedRedPadSig { }
        signal def TurnedRightSig { }
        signal def ArrivedAtPASig { }
        signal def RouteToSASig { }
        signal def RouteToSPDSig { }
        signal def StopAtSPESig { }
        signal def ExtractPiecePESig { attributes : pieceColor : PieceColor ; }

        // Actions
        EnvAction def PassMissionParameterAN ( paramIn : MissionParameter ) : MissionParameter { }
        EnvAction def PassStrategyParameterAN ( strategyIn : StrategyParameter ) : StrategyParameter { }
        EnvAction def PassNavColorAN ( colorIn : NavColor ) : NavColor { }
        EnvAction def PassIntAN ( intIn : Int ) : Int { }
        EnvAction def PassBooleanAN ( boolIn : Boolean ) : Boolean { }
        EnvAction def PassPieceColorAN ( colorIn : PieceColor ) : PieceColor { }

        // Operator behavior
        EnvActivity def OperatorEA () : ( opParamOut : MissionParameter , opStratOut : StrategyParameter ) {
            body {
                actions:
                    setMissionParametersOp : PassMissionParameterAN { using pins: paramIn : MissionParameter ; }
                    setStrategyOp : PassStrategyParameterAN { using pins: strategyIn : StrategyParameter ; }
                delegate opParamOut to setMissionParametersOp
                delegate opStratOut to setStrategyOp

                ON StartSimulationSig
                THEN setMissionParametersOp { paramIn = StartSimulationSig.mission ; }
                SEND SetMissionParamSig { param = StartSimulationSig.mission ; strategy = StartSimulationSig.strategy ; }
            }
        }

        // Closed-loop line and color navigation activity
        EnvActivity def UnitEA (
            inOpParam : MissionParameter ,
            inOpStrategy : StrategyParameter ,
            inLineOffset : Int ,
            inObstacle : Boolean ,
            inZoneAlarm : Boolean ,
            inTPieceColor : PieceColor ,
            inSPEPieceColor : PieceColor
        ) : (
            outUnitNavLine : NavColor ,
            outUnitNavPad : NavColor ,
            outUnitPieceColor : PieceColor ,
            outSPEPieceColor : PieceColor ,
            outUnitLineOffset : Int ,
            outUnitZoneAlarm : Boolean ,
            outUnitObstacle : Boolean
        ) {
            body {
                actions:
                    leavePA : PassNavColorAN { using pins : colorIn : NavColor ; }
                    detectGreenPad : PassNavColorAN { using pins : colorIn : NavColor ; }
                    turnRight : PassNavColorAN { using pins : colorIn : NavColor ; }
                    detectRedPad : PassNavColorAN { using pins : colorIn : NavColor ; }
                    stopAtT : PassNavColorAN { using pins : colorIn : NavColor ; }
                    routeToSA : PassNavColorAN { using pins : colorIn : NavColor ; }
                    routeToSPD : PassNavColorAN { using pins : colorIn : NavColor ; }
                    stopAtSPE : PassNavColorAN { using pins : colorIn : NavColor ; }
                    arriveAtTargetStock : PassNavColorAN { using pins : colorIn : NavColor ; }
                    returnJourney : PassNavColorAN { using pins : colorIn : NavColor ; }
                    arriveAtPA : PassNavColorAN { using pins : colorIn : NavColor ; }
                    acknowledgeTarget : PassNavColorAN { using pins : colorIn : NavColor ; }
                    extractPieceT : PassPieceColorAN { using pins : pieceIn : PieceColor ; }
                    extractPieceSPE : PassPieceColorAN { using pins : pieceIn : PieceColor ; }
                    insertPieceSA : PassPieceColorAN { using pins : pieceIn : PieceColor ; }
                    insertPieceSPD : PassPieceColorAN { using pins : pieceIn : PieceColor ; }
                    exposePieceT : PassPieceColorAN { using pins : pieceIn : PieceColor ; }
                    exposePieceSPE : PassPieceColorAN { using pins : pieceIn : PieceColor ; }
                    setObstacleTrue : PassBooleanAN { using pins : boolIn : Boolean ; }
                    setObstacleFalse : PassBooleanAN { using pins : boolIn : Boolean ; }

                delegate outUnitNavLine to leavePA
                delegate outUnitNavLine to turnRight
                delegate outUnitNavLine to returnJourney
                delegate outUnitNavPad to detectGreenPad
                delegate outUnitNavPad to detectRedPad
                delegate outUnitNavPad to stopAtT
                delegate outUnitNavPad to routeToSA
                delegate outUnitNavPad to routeToSPD
                delegate outUnitNavPad to stopAtSPE
                delegate outUnitNavPad to arriveAtTargetStock
                delegate outUnitPieceColor to extractPieceT
                delegate outSPEPieceColor to extractPieceSPE
                delegate outUnitPAColor to arriveAtPA
                delegate outObstacle to setObstacleTrue
                delegate outObstacle to setObstacleFalse

                ON SetMissionParamSig
                THEN leavePA { colorIn = NavColor::Black ; }
                SEND LeftPASig { }

                ON LeftPASig
                THEN detectGreenPad { colorIn = NavColor::Green ; }
                SEND DetectedGreenPadSig { }

                ON DetectedGreenPadSig
                THEN turnRight { colorIn = NavColor::Black ; }
                SEND TurnedRightSig { }

                ON TurnedRightSig
                THEN detectRedPad { colorIn = NavColor::Red ; }
                SEND DetectedRedPadSig { }

                ON DetectedRedPadSig
                THEN stopAtT { colorIn = NavColor::None ; }
                SEND UnitArrivedAtTSig { }

                ON UnitArrivedAtTSig [ inTPieceColor != PieceColor::None && (inOpStrategy != StrategyParameter::SPE_First || inSPEPieceColor == PieceColor::None) ]
                THEN exposePieceT { pieceIn = inTPieceColor ; }
                SEND ExposePieceTSig { pieceColor = inTPieceColor ; }

                ON ExposePieceTSig
                THEN extractPieceT { pieceIn = ExposePieceTSig.pieceColor ; }
                SEND GrabPieceTSig { pieceColor = ExposePieceTSig.pieceColor ; }

                ON GrabPieceTSig [ inOpParam == MissionParameter::P0 ]
                THEN routeToSA { colorIn = NavColor::Green ; }
                SEND RouteToSASig { }

                ON GrabPieceTSig [ inOpParam == MissionParameter::P1 ]
                THEN routeToSA { colorIn = NavColor::Green ; }
                SEND RouteToSASig { }

                ON UnitArrivedAtTSig [ inTPieceColor == PieceColor::None || (inOpStrategy == StrategyParameter::SPE_First && inSPEPieceColor != PieceColor::None) ]
                THEN stopAtSPE { colorIn = NavColor::None ; }
                SEND StopAtSPESig { }

                ON RouteToSASig
                THEN stopAtSPE { colorIn = NavColor::None ; }
                SEND StopAtSPESig { }

                ON RouteToSPDSig
                THEN stopAtSPE { colorIn = NavColor::None ; }
                SEND StopAtSPESig { }

                ON StopAtSPESig [ inSPEPieceColor != PieceColor::None ]
                THEN exposePieceSPE { pieceIn = inSPEPieceColor ; }
                SEND ExtractPiecePESig { pieceColor = inSPEPieceColor ; }

                ON ExtractPiecePESig
                THEN extractPieceSPE { pieceIn = ExtractPiecePESig.pieceColor ; }
                SEND ExtractedPieceSPESig { }

                ON ExtractedPieceSPESig
                THEN arriveAtTargetStock { colorIn = NavColor::Green ; }
                SEND TargetReachedSig { }

                ON StopAtSPESig [ inSPEPieceColor == PieceColor::None ]
                THEN arriveAtTargetStock { colorIn = NavColor::Green ; }
                SEND TargetReachedSig { }

                ON TargetReachedSig
                THEN insertPieceSA { pieceIn = PieceColor::Blue ; }
                SEND DropPieceSig { }

                ON DropPieceSig
                THEN returnJourney { colorIn = NavColor::Black ; }
                SEND ArrivedAtPASig { }

                ON ArrivedAtPASig
                THEN arriveAtPA { colorIn = NavColor::Black ; }

                ON ObstacleDetectedSig
                THEN setObstacleTrue { boolIn = true ; }

                ON ObstacleRemovedSig
                THEN setObstacleFalse { boolIn = false ; }
            }
        }
    }

    SceneDefinitions RobAFISScenes to RobAFISEnvironmentActivities {

        // --- UNIT 1 SCENES ---
        Scene def SCN_ObstacleStop_Unit1 {
            precondition { unit1.navLine.outColor == NavColor::Black ; }
            start ObstacleDetectedSig ;
            finish ObstacleDetectedSig ;
            postcondition { unit1.obstacle.outObstacle == true ; }
        }

        Scene def SCN_ObstacleResume_Unit1 {
            start ObstacleRemovedSig ;
            finish ObstacleRemovedSig ;
            postcondition { unit1.obstacle.outObstacle == false ; }
        }

        Scene def SCN_ReadParam_P0_Unit1 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { operator1.outParam == MissionParameter::P0 ; }
        }

        Scene def SCN_ReadParam_P1_Unit1 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { operator1.outParam == MissionParameter::P1 ; }
        }

        Scene def SCN_IdentifyPiece_T_Blue_Unit1 {
            precondition { unit1.transElevator.outPieceColor == PieceColor::Blue ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
        }

        Scene def SCN_IdentifyPiece_T_Red_Unit1 {
            precondition { unit1.transElevator.outPieceColor == PieceColor::Red ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
        }

        Scene def SCN_GrabPiece_T_Unit1 {
            precondition { unit1.transElevator.outPieceColor != PieceColor::None ; }
            start ExposePieceTSig ;
            finish GrabPieceTSig ;
            postcondition { unit1.transElevator.outPieceColor == PieceColor::None ; }
        }

        Scene def SCN_DecideRoute_SA_P0_Blue_Unit1 {
            precondition { operator1.outParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P0_Red_Unit1 {
            precondition { operator1.outParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_DecideRoute_SA_P1_Red_Unit1 {
            precondition { operator1.outParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P1_Blue_Unit1 {
            precondition { operator1.outParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_SPEArrival_Unit1 {
            precondition { unit1.entryStock.outPresence == true ; }
            start StopAtSPESig ;
            finish ExtractPiecePESig ;
        }

        Scene def SCN_Priority_Route_Target_Unit1 {
            start ExtractPiecePESig ;
            finish TargetReachedSig ;
            postcondition { unit1.navPad.outColor == NavColor::Green ; }
        }

        Scene def SCN_SkipSPE_Empty_To_Target_Unit1 {
            precondition { unit1.entryStock.outPresence == false ; }
            start RouteToSASig ;
            finish RouteToSASig ;
        }

        Scene def SCN_ReleasePiece_SA_Unit1 {
            start RouteToSASig ;
            finish DropPieceSig ;
            postcondition { unit1.arrivalStock.pieces[0].outColor != PieceColor::None ; }
        }

        Scene def SCN_ReturnJourney_From_Target_to_PA_Unit1 {
            start DropPieceSig ;
            finish ArrivedAtPASig ;
            postcondition { unit1.standbyPos.outColor == NavColor::Black ; }
        }


        // --- UNIT 2 SCENES ---
        Scene def SCN_ObstacleStop_Unit2 {
            precondition { unit2.navLine.outColor == NavColor::Black ; }
            start ObstacleDetectedSig ;
            finish ObstacleDetectedSig ;
            postcondition { unit2.obstacle.outObstacle == true ; }
        }

        Scene def SCN_ObstacleResume_Unit2 {
            start ObstacleRemovedSig ;
            finish ObstacleRemovedSig ;
            postcondition { unit2.obstacle.outObstacle == false ; }
        }

        Scene def SCN_ReadParam_P0_Unit2 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { operator1.outParam == MissionParameter::P0 ; }
        }

        Scene def SCN_ReadParam_P1_Unit2 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { operator1.outParam == MissionParameter::P1 ; }
        }

        Scene def SCN_IdentifyPiece_T_Blue_Unit2 {
            precondition { unit2.transElevator.outPieceColor == PieceColor::Blue ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
        }

        Scene def SCN_IdentifyPiece_T_Red_Unit2 {
            precondition { unit2.transElevator.outPieceColor == PieceColor::Red ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
        }

        Scene def SCN_GrabPiece_T_Unit2 {
            precondition { unit2.transElevator.outPieceColor != PieceColor::None ; }
            start ExposePieceTSig ;
            finish GrabPieceTSig ;
            postcondition { unit2.transElevator.outPieceColor == PieceColor::None ; }
        }

        Scene def SCN_DecideRoute_SA_P0_Blue_Unit2 {
            precondition { operator1.outParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P0_Red_Unit2 {
            precondition { operator1.outParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_DecideRoute_SA_P1_Red_Unit2 {
            precondition { operator1.outParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P1_Blue_Unit2 {
            precondition { operator1.outParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_SPEArrival_Unit2 {
            precondition { unit2.entryStock.outPresence == true ; }
            start StopAtSPESig ;
            finish ExtractPiecePESig ;
        }

        Scene def SCN_Priority_Route_Target_Unit2 {
            start ExtractPiecePESig ;
            finish TargetReachedSig ;
            postcondition { unit2.navPad.outColor == NavColor::Green ; }
        }

        Scene def SCN_SkipSPE_Empty_To_Target_Unit2 {
            precondition { unit2.entryStock.outPresence == false ; }
            start RouteToSASig ;
            finish RouteToSASig ;
        }

        Scene def SCN_ReleasePiece_SA_Unit2 {
            start RouteToSASig ;
            finish DropPieceSig ;
            postcondition { unit2.arrivalStock.pieces[0].outColor != PieceColor::None ; }
        }

        Scene def SCN_ReturnJourney_From_Target_to_PA_Unit2 {
            start DropPieceSig ;
            finish ArrivedAtPASig ;
            postcondition { unit2.standbyPos.outColor == NavColor::Black ; }
        }
    }

    // 14. ScenarioDefinitions: CASOS DE TESTE MODULARES (TEST CASES)
    ScenarioDefinitions ValidationPlan_RobAFIS to RobAFISScenes {

        // --- UNIT 1 SCENARIOS ---
        Scenario def Scenario_ObstacleHandling_Unit1 {
            SCN_ObstacleStop_Unit1 ;
            SCN_ObstacleResume_Unit1 ;
        }

        Scenario def Scenario_PriorityResolution_Unit1 {
            SCN_SPEArrival_Unit1 ;
            SCN_Priority_Route_Target_Unit1 ;
        }

        Scenario def Scenario_RoutingLogic_P0_Unit1 {
            SCN_ReadParam_P0_Unit1 ;
            SCN_IdentifyPiece_T_Blue_Unit1 ;
            SCN_GrabPiece_T_Unit1 ;
            SCN_DecideRoute_SA_P0_Blue_Unit1 ;
            SCN_SkipSPE_Empty_To_Target_Unit1 ;
            SCN_ReleasePiece_SA_Unit1 ;
        }

        Scenario def Scenario_RoutingLogic_P1_Unit1 {
            SCN_ReadParam_P1_Unit1 ;
            SCN_IdentifyPiece_T_Red_Unit1 ;
            SCN_GrabPiece_T_Unit1 ;
            SCN_DecideRoute_SA_P1_Red_Unit1 ;
            SCN_SkipSPE_Empty_To_Target_Unit1 ;
            SCN_ReleasePiece_SA_Unit1 ;
        }

        Scenario def Scenario_EndMission_Unit1 {
            SCN_ReturnJourney_From_Target_to_PA_Unit1 ;
        }


        // --- UNIT 2 SCENARIOS ---
        Scenario def Scenario_ObstacleHandling_Unit2 {
            SCN_ObstacleStop_Unit2 ;
            SCN_ObstacleResume_Unit2 ;
        }

        Scenario def Scenario_PriorityResolution_Unit2 {
            SCN_SPEArrival_Unit2 ;
            SCN_Priority_Route_Target_Unit2 ;
        }

        Scenario def Scenario_RoutingLogic_P0_Unit2 {
            SCN_ReadParam_P0_Unit2 ;
            SCN_IdentifyPiece_T_Blue_Unit2 ;
            SCN_GrabPiece_T_Unit2 ;
            SCN_DecideRoute_SA_P0_Blue_Unit2 ;
            SCN_SkipSPE_Empty_To_Target_Unit2 ;
            SCN_ReleasePiece_SA_Unit2 ;
        }

        Scenario def Scenario_RoutingLogic_P1_Unit2 {
            SCN_ReadParam_P1_Unit2 ;
            SCN_IdentifyPiece_T_Red_Unit2 ;
            SCN_GrabPiece_T_Unit2 ;
            SCN_DecideRoute_SA_P1_Red_Unit2 ;
            SCN_SkipSPE_Empty_To_Target_Unit2 ;
            SCN_ReleasePiece_SA_Unit2 ;
        }

        Scenario def Scenario_EndMission_Unit2 {
            SCN_ReturnJourney_From_Target_to_PA_Unit2 ;
        }
    }

    ScenarioExecution ScenarioExecution_P0_T_First_Obstacle to ValidationPlan_RobAFIS {
        mode: once ;

        // Sinal inicial configurando P0 e T_First
        inject StartSimulationSig { mission = MissionParameter::P0 ; strategy = StrategyParameter::T_First ; } immediate ;

        // Reativo: Injeta obstáculo na Unidade 1 assim que o sensor do robô lê Green (verde) na pista
        inject ObstacleDetectedSig when unit1.navPad.outColor == NavColor::Green ;

        // Seqüencial: Remove obstáculo na Unidade 1 após 1000ms
        inject ObstacleRemovedSig after 1000 ;

        // Inventário Inicial Unidade 1: Peça Azul (P1) no T (deve ir para a SA)
        unit1.transElevator.pieces[0].outPresence = true ;
        unit1.transElevator.pieces[0].outColor = PieceColor::Blue ;
        unit1.entryStock.pieces[0].outPresence = false ;

        // Inventário Inicial Unidade 2: Peça Azul (P1) no T (deve ir para a SA)
        unit2.transElevator.pieces[0].outPresence = true ;
        unit2.transElevator.pieces[0].outColor = PieceColor::Blue ;
        unit2.entryStock.pieces[0].outPresence = false ;

        parallel {
            Scenario_RoutingLogic_P0_Unit1 ;
            Scenario_ObstacleHandling_Unit1 ;
            Scenario_EndMission_Unit1 ;

            Scenario_RoutingLogic_P0_Unit2 ;
            Scenario_EndMission_Unit2 ;
        }
    }

    ScenarioExecution ScenarioExecution_P0_SPE_First_Priority to ValidationPlan_RobAFIS {
        mode: once ;

        inject StartSimulationSig { mission = MissionParameter::P0 ; strategy = StrategyParameter::SPE_First ; } immediate ;

        // Injeta obstáculo na Unidade 2 após 200ms
        inject ObstacleDetectedSig after 200 ;
        // Remove obstáculo na Unidade 2 após 1200ms
        inject ObstacleRemovedSig after 1200 ;

        // Inventário Unidade 1 (Ambos cheios): Prioriza SPE (Azul) e depois pega T (Azul)
        unit1.transElevator.pieces[0].outPresence = true ;
        unit1.transElevator.pieces[0].outColor = PieceColor::Blue ;
        unit1.entryStock.pieces[0].outPresence = true ;
        unit1.entryStock.pieces[0].outColor = PieceColor::Blue ;

        // Inventário Unidade 2 (Ambos cheios): Prioriza SPE (Vermelha) e depois pega T (Azul)
        unit2.transElevator.pieces[0].outPresence = true ;
        unit2.transElevator.pieces[0].outColor = PieceColor::Blue ;
        unit2.entryStock.pieces[0].outPresence = true ;
        unit2.entryStock.pieces[0].outColor = PieceColor::Red ;

        parallel {
            Scenario_PriorityResolution_Unit1 ;
            Scenario_RoutingLogic_P0_Unit1 ;
            Scenario_EndMission_Unit1 ;

            Scenario_PriorityResolution_Unit2 ;
            Scenario_ObstacleHandling_Unit2 ;
            Scenario_RoutingLogic_P0_Unit2 ;
            Scenario_EndMission_Unit2 ;
        }
    }

    ScenarioExecution ScenarioExecution_P1_T_First_Bypass to ValidationPlan_RobAFIS {
        mode: once ;

        inject StartSimulationSig { mission = MissionParameter::P1 ; strategy = StrategyParameter::T_First ; } immediate ;

        // Simula uma perturbação externa na linha de navegação após 10 passos de simulação
        inject LineOffsetChangedSig { offset = 3 ; } after 10 ;

        // Inventário Unidade 1: Peça vermelha (P2) no T (deve ir para a SA devido a p = 1)
        unit1.transElevator.pieces[0].outPresence = true ;
        unit1.transElevator.pieces[0].outColor = PieceColor::Red ;
        unit1.entryStock.pieces[0].outPresence = false ;

        // Unidade 2 (Bypass): T está vazio, mas tem peça na SPE. Robô deve pular o T e ir direto para o SPE.
        unit2.transElevator.pieces[0].outPresence = false ;
        unit2.entryStock.pieces[0].outPresence = true ;
        unit2.entryStock.pieces[0].outColor = PieceColor::Red ;

        parallel {
            Scenario_RoutingLogic_P1_Unit1 ;
            Scenario_EndMission_Unit1 ;

            Scenario_PriorityResolution_Unit2 ;
            Scenario_EndMission_Unit2 ;
        }
    }

    ScenarioExecution ScenarioExecution_P1_SPE_First_Inverted to ValidationPlan_RobAFIS {
        mode: once ;

        inject StartSimulationSig { mission = MissionParameter::P1 ; strategy = StrategyParameter::SPE_First ; } immediate ;

        // Injeta obstáculo na Unidade 1 após 1200ms
        inject ObstacleDetectedSig after 1200 ;
        // Remove obstáculo na Unidade 1 após 2200ms
        inject ObstacleRemovedSig after 2200 ;

        // Unidade 1: Peça Vermelha (P2) no T, Azul (P1) no SPE. Prioriza SPE (SPD) e depois pega T (SA).
        unit1.transElevator.pieces[0].outPresence = true ;
        unit1.transElevator.pieces[0].outColor = PieceColor::Red ;
        unit1.entryStock.pieces[0].outPresence = true ;
        unit1.entryStock.pieces[0].outColor = PieceColor::Blue ;

        // Unidade 2: Peça Vermelha (P2) no T, Azul (P1) no SPE. Prioriza SPE (SPD) e depois pega T (SA).
        unit2.transElevator.pieces[0].outPresence = true ;
        unit2.transElevator.pieces[0].outColor = PieceColor::Red ;
        unit2.entryStock.pieces[0].outPresence = true ;
        unit2.entryStock.pieces[0].outColor = PieceColor::Blue ;

        parallel {
            Scenario_PriorityResolution_Unit1 ;
            Scenario_RoutingLogic_P1_Unit1 ;
            Scenario_ObstacleHandling_Unit1 ;
            Scenario_EndMission_Unit1 ;

            Scenario_PriorityResolution_Unit2 ;
            Scenario_RoutingLogic_P1_Unit2 ;
            Scenario_EndMission_Unit2 ;
        }
    }
}
// =========================================================================
// allocations (Unified mapping of components, behaviors & executables)
// =========================================================================
allocations {
    envActivity OperatorEA to HumanOperatorEnvCP
    envActivity UnitEA to ProductionUnitEnvCP

    // 1. Software Comportamental (Controlador Composto)
    activity SysADL.Behavior::MissionPlannerAC to SysADL.Components::MissionPlannerCP
    activity SysADL.Behavior::NavigatorAC to SysADL.Components::NavigatorCP
    activity SysADL.Behavior::CargoHandlerAC to SysADL.Components::CargoHandlerCP
    activity SysADL.Behavior::RobAFISControllerAC to SysADL.Components::RobAFISControllerCP

    // 2. Comportamento das Fronteiras (Boundary activities para a HAL)
    activity BoundaryBehavior::ParameterInputAC to SysADL.Components::ParameterInputCP
    activity BoundaryBehavior::CameraSensorAC to SysADL.Components::CameraSensorCP
    activity BoundaryBehavior::ObstacleSensorAC to SysADL.Components::ObstacleSensorCP
    activity BoundaryBehavior::DriveSystemAC to SysADL.Components::DriveSystemCP
    activity BoundaryBehavior::GrabberAC to SysADL.Components::GrabberCP

    // 3. Executáveis do Sistema (Inteligência Central de Software)
    executable SysADL.Execution::ConfigureMissionEX to SysADL.Behavior::ConfigureMissionAN
    executable SysADL.Execution::DecideCommandEX to SysADL.Behavior::DecideCommandAN
    executable SysADL.Execution::ExtractDirEX to SysADL.Behavior::ExtractDirAN
    executable SysADL.Execution::VerifyCargoEX to SysADL.Behavior::VerifyCargoAN
    executable SysADL.Execution::ExtractGrabEX to SysADL.Behavior::ExtractGrabAN

    // 4. Executáveis de Fronteira (Isolados no pacote BoundaryExecution)
    executable BoundaryExecution::PassBooleanEX to BoundaryBehavior::PassBooleanAN
    executable BoundaryExecution::PassIntEX to BoundaryBehavior::PassIntAN
    executable BoundaryExecution::PassNavColorEX to BoundaryBehavior::PassNavColorAN
    executable BoundaryExecution::PassPieceColorEX to BoundaryBehavior::PassPieceColorAN
    executable BoundaryExecution::PassDirectionEX to BoundaryBehavior::PassDirectionAN
    executable BoundaryExecution::PassMotorCommandEX to BoundaryBehavior::PassMotorCommandAN
    executable BoundaryExecution::PassMissionParameterEX to BoundaryBehavior::PassMissionParameterAN
    executable BoundaryExecution::PassStrategyParameterEX to BoundaryBehavior::PassStrategyParameterAN
}