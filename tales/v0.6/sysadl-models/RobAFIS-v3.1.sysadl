Model SysADLModel ; 

// TYPES
package SysADL.types {
value type Int {}
    value type Boolean {}
    value type String {}
    value type Void {}
    value type Real {}

    enum PieceColor { Blue , Red , None }
    enum MissionParameter { P0 , P1 }
    enum StrategyParameter { T_First , SPE_First }
    enum MotorCommand { On , Off }
    enum Direction { Forward , Left , Right , SoftLeft , SoftRight , Stop }
    enum NavColor { Black , Green , Red , None }

    datatype MissionConfig {
        attributes:
            mission : MissionParameter ;
            strategy : StrategyParameter ;
    }

    datatype RobotCommands {
        attributes:
            dir : Direction ;
            grab : MotorCommand ;
    }
}

// STRUCTURAL PORT TYPES
package SysADL.Ports {
    import SysADL.types;

port def ParameterIPT { flow in MissionParameter }
    port def ParameterOPT { flow out MissionParameter }

    port def StrategyIPT { flow in StrategyParameter }
    port def StrategyOPT { flow out StrategyParameter }

    port def PieceColorIPT { flow in PieceColor }
    port def PieceColorOPT { flow out PieceColor }

    port def BooleanIPT { flow in Boolean }
    port def BooleanOPT { flow out Boolean }

    port def DirectionIPT { flow in Direction }
    port def DirectionOPT { flow out Direction }

    port def CommandIPT { flow in MotorCommand }
    port def CommandOPT { flow out MotorCommand }

    port def IntIPT { flow in Int }
    port def IntOPT { flow out Int }

    port def NavColorIPT { flow in NavColor }
    port def NavColorOPT { flow out NavColor }

    port def MissionConfigIPT { flow in MissionConfig }
    port def MissionConfigOPT { flow out MissionConfig }
}

// STRUCTURAL CONNECTOR TYPES
package SysADL.Connectors {
    import SysADL.types;
    import SysADL.Ports;

connector def ParamCN {
        participants:
            ~ outP : ParameterOPT ;
            ~ inP : ParameterIPT ;
        flows:
            MissionParameter from outP to inP
    }

    connector def StrategyCN {
        participants:
            ~ outS : StrategyOPT ;
            ~ inS : StrategyIPT ;
        flows:
            StrategyParameter from outS to inS
    }

    connector def PieceColorCN {
        participants:
            ~ outC : PieceColorOPT ;
            ~ inC : PieceColorIPT ;
        flows:
            PieceColor from outC to inC
    }

    connector def BooleanCN {
        participants:
            ~ outB : BooleanOPT ;
            ~ inB : BooleanIPT ;
        flows:
            Boolean from outB to inB
    }

    connector def DirectionCN {
        participants:
            ~ outD : DirectionOPT ;
            ~ inD : DirectionIPT ;
        flows:
            Direction from outD to inD
    }

    connector def CommandCN {
        participants:
            ~ outC : CommandOPT ;
            ~ inC : CommandIPT ;
        flows:
            MotorCommand from outC to inC
    }

    connector def IntCN {
        participants:
            ~ outI : IntOPT ;
            ~ inI : IntIPT ;
        flows:
            Int from outI to inI
    }

    connector def NavColorCN {
        participants:
            ~ outN : NavColorOPT ;
            ~ inN : NavColorIPT ;
        flows:
            NavColor from outN to inN
    }

    connector def MissionConfigCN {
        participants:
            ~ outMC : MissionConfigOPT ;
            ~ inMC : MissionConfigIPT ;
        flows:
            MissionConfig from outMC to inMC
    }
}

// STRUCTURAL COMPONENTS
package SysADL.Components {
    import SysADL.types;
    import SysADL.Ports;
    import SysADL.Connectors;

// Boundary Component: Parameter and Strategy Input Panel
    boundary component def ParameterInputCP {
        ports:
            pOut : ParameterOPT ;
            strategyOut : StrategyOPT ;
    }


    boundary component def CameraSensorCP {
        ports:
            floorColorOut : NavColorOPT ;
            lineOffsetOut : IntOPT ;
            zoneAlarmOut : BooleanOPT ;
            pieceColorOut : PieceColorOPT ;
    }

    boundary component def ObstacleSensorCP {
        ports:
            obstacleOut : BooleanOPT ;
    }

    boundary component def DriveSystemCP {
        ports:
            dirIn : DirectionIPT ;
    }

    boundary component def GrabberCP {
        ports:
            cmdIn : CommandIPT ;
    }

   
    component def MissionPlannerCP {
        ports:
            planner_inParam : ParameterIPT ;
            planner_inStrategy : StrategyIPT ;
            planner_outConfig : MissionConfigOPT ;
    }

    component def NavigatorCP {
        ports:
            navigator_inFloorColor : NavColorIPT ;
            navigator_inLineOffset : IntIPT ;
            navigator_inZoneAlarm : BooleanIPT ;
            navigator_inObstacle : BooleanIPT ;
            navigator_inConfig : MissionConfigIPT ;
            navigator_outDir : DirectionOPT ;
    }

    component def CargoHandlerCP {
        ports:
            cargo_inPieceColor : PieceColorIPT ;
            cargo_inConfig : MissionConfigIPT ;
            cargo_outGrab : CommandOPT ;
    }

    component def RobAFISControllerCP {
        ports:
            controller_inParam : ParameterIPT ;
            controller_inStrategy : StrategyIPT ;
            controller_inFloorColor : NavColorIPT ;
            controller_inLineOffset : IntIPT ;
            controller_inZoneAlarm : BooleanIPT ;
            controller_inObstacle : BooleanIPT ;
            controller_inPieceColor : PieceColorIPT ;
            controller_outDir : DirectionOPT ;
            controller_outGrab : CommandOPT ;
        configuration {
            components:
                planner : MissionPlannerCP {
                    using ports:
                        planner_inParam : ParameterIPT ;
                        planner_inStrategy : StrategyIPT ;
                        planner_outConfig : MissionConfigOPT ;
                }
                navigator : NavigatorCP {
                    using ports:
                        navigator_inFloorColor : NavColorIPT ;
                        navigator_inLineOffset : IntIPT ;
                        navigator_inZoneAlarm : BooleanIPT ;
                        navigator_inObstacle : BooleanIPT ;
                        navigator_inConfig : MissionConfigIPT ;
                        navigator_outDir : DirectionOPT ;
                }
                cargo : CargoHandlerCP {
                    using ports:
                        cargo_inPieceColor : PieceColorIPT ;
                        cargo_inConfig : MissionConfigIPT ;
                        cargo_outGrab : CommandOPT ;
                }
            connectors:
                c_config1 : MissionConfigCN bindings planner_outConfig = navigator_inConfig ;
                c_config2 : MissionConfigCN bindings planner_outConfig = cargo_inConfig ;
            delegations:
                planner_inParam to controller_inParam  
                planner_inStrategy to controller_inStrategy
                navigator_inFloorColor to controller_inFloorColor 
                navigator_inLineOffset to controller_inLineOffset  
                navigator_inZoneAlarm to controller_inZoneAlarm  
                navigator_inObstacle to controller_inObstacle  
                cargo_inPieceColor to controller_inPieceColor  
                navigator_outDir to controller_outDir  
                cargo_outGrab to controller_outGrab
        }
    }

    component def RobAFISSystemCP {
        configuration {
            components:
                pInput : ParameterInputCP {
                    using ports:
                        pOut : ParameterOPT ;
                        strategyOut : StrategyOPT ;
                }
                camera : CameraSensorCP {
                    using ports:
                        floorColorOut : NavColorOPT ;
                        lineOffsetOut : IntOPT ;
                        zoneAlarmOut : BooleanOPT ;
                        pieceColorOut : PieceColorOPT ;
                }
                obstacleSens : ObstacleSensorCP {
                    using ports:
                        obstacleOut : BooleanOPT ;
                }
                driveSys : DriveSystemCP {
                    using ports:
                        dirIn : DirectionIPT ;
                }
                grabber : GrabberCP {
                    using ports:
                        cmdIn : CommandIPT ;
                }
                controller : RobAFISControllerCP {
                    using ports:
                        controller_inParam : ParameterIPT ;
                        controller_inStrategy : StrategyIPT ;
                        controller_inFloorColor : NavColorIPT ;
                        controller_inLineOffset : IntIPT ;
                        controller_inZoneAlarm : BooleanIPT ;
                        controller_inObstacle : BooleanIPT ;
                        controller_inPieceColor : PieceColorIPT ;
                        controller_outDir : DirectionOPT ;
                        controller_outGrab : CommandOPT ;
                }
            connectors:
                c1 : ParamCN bindings pOut = controller_inParam ;
                c2 : StrategyCN bindings strategyOut = controller_inStrategy ;
                c3 : NavColorCN bindings floorColorOut = controller_inFloorColor ;
                c4 : IntCN bindings lineOffsetOut = controller_inLineOffset ;
                c5 : BooleanCN bindings zoneAlarmOut = controller_inZoneAlarm ;
                c6 : BooleanCN bindings obstacleOut = controller_inObstacle ;
                c7 : PieceColorCN bindings pieceColorOut = controller_inPieceColor ;
                c8 : DirectionCN bindings controller_outDir = dirIn ;
                c9 : CommandCN bindings controller_outGrab = cmdIn ;
        }
    }
}

// BEHAVIORAL VIEWPOINT
package SysADL.Behavior {
    import SysADL.types;

action def ConfigureMissionAN ( paramIn : MissionParameter , strategyIn : StrategyParameter ) : MissionConfig {}
    action def DecideCommandAN ( decFloorColor : NavColor , decOffset : Int , decZoneAlarm : Boolean , decObstacle : Boolean , decConfig : MissionConfig ) : RobotCommands {}
    action def ExtractDirAN ( extDirCmd : RobotCommands ) : Direction {}
    action def VerifyCargoAN ( cargoPieceColor : PieceColor , cargoConfig : MissionConfig ) : RobotCommands {}
    action def ExtractGrabAN ( extGrabCmd : RobotCommands ) : MotorCommand {}

    activity def MissionPlannerAC ( actParam : MissionParameter ) ( actStrategy : StrategyParameter ) : ( actConfig : MissionConfig ) {
        body {
            actions:
                configAct : ConfigureMissionAN {
                    using pins:
                        paramIn : MissionParameter ;
                        strategyIn : StrategyParameter ;
                }
            delegate actParam to paramIn 
            delegate actStrategy to strategyIn 
            delegate actConfig to configAct 
        }
    }

    activity def NavigatorAC (
        actFloorColor : NavColor ) (
        actLineOffset : Int ) (
        actZoneAlarm : Boolean ) (
        actObstacle : Boolean ) (
        actConfig : MissionConfig
    ) : ( actDir : Direction ) {
        body {
            actions:
                navAct : DecideCommandAN {
                    using pins:
                        decFloorColor : NavColor ;
                        decOffset : Int ;
                        decZoneAlarm : Boolean ;
                        decObstacle : Boolean ;
                        decConfig : MissionConfig ;
                }
                extDirAct : ExtractDirAN {
                    using pins:
                        extDirCmd : RobotCommands ;
                }
            delegate actFloorColor to decFloorColor 
            delegate actLineOffset to decOffset 
            delegate actZoneAlarm to decZoneAlarm 
            delegate actObstacle to decObstacle 
            delegate actConfig to decConfig 
            delegate actDir to extDirAct
            
            flow from navAct to extDirCmd 
        }
    }

    activity def CargoHandlerAC ( actPieceColor : PieceColor ) ( actConfig : MissionConfig ) : ( actGrab : MotorCommand ) {
        body {
            actions:
                cargoAct : VerifyCargoAN {
                    using pins:
                        cargoPieceColor : PieceColor ;
                        cargoConfig : MissionConfig ;
                }
                extGrabAct : ExtractGrabAN {
                    using pins:
                        extGrabCmd : RobotCommands ;
                }
            delegate actPieceColor to cargoPieceColor 
            delegate actConfig to cargoConfig 
            delegate actGrab to extGrabAct
            
            flow from cargoAct to extGrabCmd
        }
    }
}

// EXECUTABLE VIEWPOINT
package SysADL.Execution {
    import SysADL.types;

executable def ConfigureMissionEX ( in paramIn : MissionParameter , in strategyIn : StrategyParameter ) : out MissionConfig {
        let cfg : MissionConfig ;
    	cfg->mission = paramIn;
    	cfg->strategy = strategyIn;
    	
        return cfg;
    }

    executable def DecideCommandEX ( in decFloorColor : NavColor , in decOffset : Int , in decZoneAlarm : Boolean , in decObstacle : Boolean , in decConfig : MissionConfig ) : out RobotCommands {
        let cmds : RobotCommands ;
        
        // 1. Zone Machine collision or intrusion safeguard
        if (decObstacle == true) {
            cmds->dir = Direction::Stop ;
            cmds->grab = MotorCommand::Off ;
            return cmds ;
        }
        
        if (decZoneAlarm == true) {
            cmds->dir = Direction::Stop ;
            cmds->grab = MotorCommand::Off ;
            return cmds ;
        }

        // 2. Proportional trajectory control logic
        if (decOffset < (0 - 10)) {
            cmds->dir = Direction::SoftLeft ;
            cmds->grab = MotorCommand::Off ;
            return cmds ;
        }
        
        if (decOffset > 10) {
            cmds->dir = Direction::SoftRight ;
            cmds->grab = MotorCommand::Off ;
            return cmds ;
        }

        // 3. Logic based on strategy and soil color
        if (decConfig->strategy == StrategyParameter::SPE_First) {
            if (decFloorColor == NavColor::Green) {
                cmds->dir = Direction::Stop ;
                cmds->grab = MotorCommand::Off ;
                return cmds ;
            }
        }

        if (decFloorColor == NavColor::Red) {
            cmds->dir = Direction::Stop ;
            cmds->grab = MotorCommand::Off ;
            return cmds ;
        }

        // 4. Nominal rectilinear trajectory
        cmds->dir = Direction::Forward ;
        cmds->grab = MotorCommand::Off ;
        return cmds ;
    }

    executable def ExtractDirEX ( in extDirCmd : RobotCommands ) : out Direction {
        return extDirCmd->dir ;
    }

    executable def VerifyCargoEX ( in cargoPieceColor : PieceColor , in cargoConfig : MissionConfig ) : out RobotCommands {
        let cmds : RobotCommands ;
        cmds->dir = Direction::Forward ;
        
        if (cargoPieceColor == PieceColor::Blue) {
            cmds->grab = MotorCommand::On ;
            return cmds ;
        }
        if (cargoPieceColor == PieceColor::Red) {
            cmds->grab = MotorCommand::On ;
            return cmds ;
        }
        cmds->grab = MotorCommand::Off ;
        return cmds ;
    }

    executable def ExtractGrabEX ( in extGrabCmd : RobotCommands ) : out MotorCommand {
        return extGrabCmd->grab ;
    }
}

// ENVPORTS & ENVCONNECTORS 

package EnvPortsRobAFIS {
    import SysADL.types;

EnvPort def InPieceColor { flow in PieceColor }
	EnvPort def OutPieceColor { flow out PieceColor }
	EnvPort def InNavColor { flow in NavColor }
	EnvPort def OutNavColor { flow out NavColor }
	EnvPort def InBoolean { flow in Boolean }
	EnvPort def OutBoolean { flow out Boolean }
	EnvPort def InParameter { flow in MissionParameter }
	EnvPort def OutParameter { flow out MissionParameter }
	EnvPort def InStrategy { flow in StrategyParameter }
	EnvPort def OutStrategy { flow out StrategyParameter }
	EnvPort def InMotorCommand { flow in MotorCommand }
	EnvPort def OutMotorCommand { flow out MotorCommand }
	EnvPort def InInt { flow in Int }
	EnvPort def OutInt { flow out Int }
}

package EnvConnectorsRobAFIS {
    import SysADL.types;
    import EnvPortsRobAFIS;

EnvConnector def PieceColorEnvCN {
		participants:
			~ outColor: OutPieceColor;
			~ inColor: InPieceColor;
		flows: PieceColor from outColor to inColor
	}

	EnvConnector def NavColorEnvCN {
		participants:
			~ outColor: OutNavColor;
			~ inColor: InNavColor;
		flows: NavColor from outColor to inColor
	}

	EnvConnector def ParamEnvCN {
		participants:
			~ outP: OutParameter;
			~ inP: InParameter;
		flows: MissionParameter from outP to inP
	}

	EnvConnector def StrategyEnvCN {
		participants:
			~ outS: OutStrategy;
			~ inS: InStrategy;
		flows: StrategyParameter from outS to inS
	}

	EnvConnector def MotorCommandEnvCN {
		participants:
			~ outC: OutMotorCommand;
			~ inC: InMotorCommand;
		flows: MotorCommand from outC to inC
	}

	EnvConnector def OffsetEnvCN {
		participants:
			~ outOffset: OutInt;
			~ inOffset: InInt;
		flows: Int from outOffset to inOffset
	}

	EnvConnector def ObstacleEnvCN {
		participants:
			~ outObstacle: OutBoolean;
			~ inObstacle: InBoolean;
		flows: Boolean from outObstacle to inObstacle
	}
}

// ENVCOMPONENTS & REOPENED FRONTIERS (Atelier Entities)

package EnvComponentsRobAFIS {
	import SysADL.types;
	import SysADL.Components;
	import EnvPortsRobAFIS;
	import EnvConnectorsRobAFIS;

	boundary component SysADL.Components::ParameterInputCP {
		envPorts:
			inParam : InParameter;
			inStrategy : InStrategy;
	}

	boundary component SysADL.Components::CameraSensorCP {
		envPorts:
			inPieceColor : InPieceColor;
			inFloorColor : InNavColor;
			inSaPieceColor : InPieceColor;
			inSpePieceColor : InPieceColor;
			inLineOffset : InInt;
			inZoneColor : InNavColor;
	}

	boundary component SysADL.Components::ObstacleSensorCP {
		envPorts:
			inObstacle : InBoolean;
	}

	boundary component SysADL.Components::GrabberCP {
		envPorts:
			outGrabT : OutMotorCommand;
			outGrabSa : OutMotorCommand;
			outGrabSpe : OutMotorCommand;
			outGrabSpd : OutMotorCommand;
	}

	EnvComponent def PieceEnvCP {
		envPorts:
			outColor : OutPieceColor ;
			inCommand : InMotorCommand ;
			outCommand : OutMotorCommand ;
		properties:
			Property def color : PieceColor ;
	}

	EnvComponent def NavigationLineEnvCP {
		envPorts:
			outColor : OutNavColor ;
		properties:
			Property def color : NavColor ;
	}

	EnvComponent def NavigationPadEnvCP {
		envPorts:
			outColor : OutNavColor ;
		properties:
			Property def color : NavColor ;
	}

	EnvComponent def MachineZoneEnvCP {
		envPorts:
			outColor : OutNavColor ;
		properties:
			Property def color : NavColor ;
	}

	EnvComponent def StandbyPositionEnvCP {
		envPorts:
			outColor : OutNavColor ;
		properties:
			Property def color : NavColor ;
	}

	EnvComponent def ObstacleEnvCP {
		envPorts:
			outObstacle : OutBoolean ;
		properties:
			Property def isPresent : Boolean ;
	}

	EnvComponent def HumanOperatorEnvCP {
		envPorts:
			outParam : OutParameter ;
			outStrategy : OutStrategy ;
	}

	EnvComponent def TransElevatorEnvCP {
		envPorts:
			inCommand : InMotorCommand ;
			outPieceColor : OutPieceColor ;
			outCommand : OutMotorCommand ;

		environmentConfiguration TransElevatorConfig {
			envComponents:
				pieces: PieceEnvCP [0..3] ;

			envDelegations:
				outCommand to pieces.outCommand ;
				pieces.outColor to outPieceColor ;
				pieces.inCommand to inCommand ;

		}
	}

	EnvComponent def ArrivalStockEnvCP {
		envPorts:
			inCommand : InMotorCommand ;
			outPieceColor : OutPieceColor ;
			outCommand : OutMotorCommand ;

		environmentConfiguration ArrivalConfig {
			envComponents:
				pieces: PieceEnvCP [0..3] ;

			envDelegations:
				pieces.inCommand to inCommand ;
				pieces.outColor to outPieceColor ;
				pieces.outCommand to outCommand ;

		}
	}

	EnvComponent def SharedStockEnvCP {
		envPorts:
			inDropCommand : InMotorCommand ;
			outPieceColor : OutPieceColor ;
			outCommand : OutMotorCommand ;
			inGrabCommand : InMotorCommand ;

		environmentConfiguration SharedConfig {
			envComponents:
				pieces: PieceEnvCP [0..3] ;

			envDelegations:
				pieces.outColor to outPieceColor ;
				inDropCommand to pieces.inCommand ;
				inGrabCommand to pieces.inCommand ;
				pieces.outCommand to outCommand ;

		}

	}

	EnvComponent def ProductionUnitEnvCP {
		envPorts:
			inSpePieceColor : InPieceColor ;
			outSpeGrabCommand : OutMotorCommand ;
			outSpdGrabCommand : OutMotorCommand ;

		environmentConfiguration UnitConfig {
			envComponents:
				arrivalStock: ArrivalStockEnvCP ;
				machineZone: MachineZoneEnvCP ;
				navLine: NavigationLineEnvCP ;
				navPad: NavigationPadEnvCP ;
				obstacle: ObstacleEnvCP ;
				operator: HumanOperatorEnvCP ;
				standbyPos: StandbyPositionEnvCP ;
				transElevator: TransElevatorEnvCP ;

			components:
				instance1: GrabberCP ;
				unit_camera: CameraSensorCP ;
				unit_obstacleSens: ObstacleSensorCP ;
				unit_pInput: ParameterInputCP ;

			envDelegations:
				unit_camera.inSpePieceColor to inSpePieceColor ;
				instance1.outGrabSpe to outSpeGrabCommand ;
				instance1.outGrabSpd to outSpdGrabCommand ;

			envConnectors:
				obsC: ObstacleEnvCN bindings obstacle.outObstacle = unit_obstacleSens.inObstacle ;
				lineC: NavColorEnvCN bindings navLine.outColor = unit_camera.inFloorColor ;
				offsetC: OffsetEnvCN bindings navLine.outColor = unit_camera.inLineOffset ;
				zoneC: NavColorEnvCN bindings machineZone.outColor = unit_camera.inZoneColor ;
				opParamC: ParamEnvCN bindings operator.outParam = unit_pInput.inParam ;
				opStrategyC: StrategyEnvCN bindings operator.outStrategy = unit_pInput.inStrategy ;
				tColorC: PieceColorEnvCN bindings transElevator.outPieceColor = unit_camera.inPieceColor ;
				saColorC: PieceColorEnvCN bindings arrivalStock.outPieceColor = unit_camera.inSaPieceColor ;
				grabTC: MotorCommandEnvCN bindings instance1.outGrabT = transElevator.inCommand ;
				grabSaC: MotorCommandEnvCN bindings instance1.outGrabSa = arrivalStock.inCommand ;

		}
	}

	EnvComponent def AtelierEnvCP {

		environmentConfiguration AtelierConfig {
			envComponents:
				spd1_spe2: SharedStockEnvCP ;
				spe1_spd2: SharedStockEnvCP ;
				unit1: ProductionUnitEnvCP ;
				unit2: ProductionUnitEnvCP ;

			envConnectors:
				conn1: MotorCommandEnvCN bindings unit1.outSpdGrabCommand = spd1_spe2.inDropCommand ;
				u2SpeGrabC: MotorCommandEnvCN bindings unit2.outSpeGrabCommand = spd1_spe2.inGrabCommand ;
				u2SpeReadC: PieceColorEnvCN bindings spd1_spe2.outPieceColor = unit2.inSpePieceColor ;
				u2SpdGrabC: MotorCommandEnvCN bindings unit2.outSpdGrabCommand = spe1_spd2.inDropCommand ;
				u1SpeGrabC: MotorCommandEnvCN bindings unit1.outSpeGrabCommand = spe1_spd2.inGrabCommand ;
				u1SpeReadC: PieceColorEnvCN bindings spe1_spd2.outCommand = unit1.inSpePieceColor ;

		}

	}

}

// BOUNDARYBEHAVIOR (Boundary Activities)

package BoundaryBehavior {
    import SysADL.types;

    action def PassBooleanAN ( boolIn : Boolean ) : Boolean { }
    action def PassIntAN ( intIn : Int ) : Int { }
    action def PassNavColorAN ( colorIn : NavColor ) : NavColor { }
    action def PassPieceColorAN ( pColorIn : PieceColor ) : PieceColor { }
    action def PassDirectionAN ( dirIn : Direction ) : Direction { }
    action def PassMotorCommandAN ( cmdIn : MotorCommand ) : MotorCommand { }
    action def PassMissionParameterAN ( paramIn : MissionParameter ) : MissionParameter { }
    action def PassStrategyParameterAN ( strategyIn : StrategyParameter ) : StrategyParameter { }
    action def MultiplexPieceColorAN ( colorT : PieceColor , colorSa : PieceColor , colorSpe : PieceColor ) : PieceColor {}
    action def ProcessZoneAlarmAN ( zoneColor : NavColor ) : Boolean {}
    
    activity def ParameterInputAC ( envParam : MissionParameter , envStrategy : StrategyParameter ) : ( sysParam : MissionParameter , sysStrategy : StrategyParameter ) {
        body {
            actions:
                passP : PassMissionParameterAN { using pins: paramIn : MissionParameter ; paramOut : MissionParameter ; }
                passS : PassStrategyParameterAN { using pins: strategyIn : StrategyParameter ; strategyOut : StrategyParameter ; }
            delegate envParam to passP.paramIn
            delegate sysParam to passP.paramOut
            delegate envStrategy to passS.strategyIn
            delegate sysStrategy to passS.strategyOut
        }
    }
    activity def CameraSensorAC (
        envFloor : NavColor ,
        envOffset : Int ,
        envZone : NavColor ,
        envPiece : PieceColor ,
        envSaPiece : PieceColor ,
        envSpePiece : PieceColor
    ) : (
        sysFloor : NavColor ,
        sysOffset : Int ,
        sysZone : Boolean ,
        sysPiece : PieceColor
    ) {
        body {
            actions:
                passF : PassNavColorAN { 
                    using pins: colorIn : NavColor ; colorOut : NavColor ; 
                }
                passO : PassIntAN { 
                    using pins: intIn : Int ; intOut : Int ; 
                }
                detectZ : ProcessZoneAlarmAN { 
                    using pins: zoneColor : NavColor ; alarmOut : Boolean ; 
                }
                muxP : MultiplexPieceColorAN { 
                    using pins: colorT : PieceColor ; colorSa : PieceColor ; colorSpe : PieceColor ; pieceOut : PieceColor ; 
                }
            
            delegate envFloor to colorIn
            delegate sysFloor to colorOut
            
            delegate envOffset to intIn
            delegate sysOffset to intOut
            
            delegate envZone to zoneColor
            delegate sysZone to alarmOut
            
            delegate envPiece to colorT
            delegate envSaPiece to colorSa
            delegate envSpePiece to colorSpe
            delegate sysPiece to pieceOut
        }
    }

    activity def ObstacleSensorAC ( envObstacle : Boolean ) : ( sysObstacle : Boolean ) {
        body {
            actions:
                passObstacle : PassBooleanAN { using pins: boolIn : Boolean ; boolOut : Boolean ; }
            delegate envObstacle to passObstacle.boolIn
            delegate sysObstacle to passObstacle.boolOut
        }
    }

    activity def DriveSystemAC ( sysDir : Direction ) : ( envDir : Direction ) {
        body {
            actions:
                passDir : PassDirectionAN { using pins: dirIn : Direction ; dirOut : Direction ; }
            delegate sysDir to passDir.dirIn
            delegate envDir to passDir.dirOut
        }
    }

    activity def GrabberAC ( 
        sysCmd : MotorCommand 
    ) : ( 
        envGrabT : MotorCommand , 
        envGrabSa : MotorCommand , 
        envGrabSpe : MotorCommand , 
        envGrabSpd : MotorCommand 
    ) {
        body {
            actions:
                passCmdT : PassMotorCommandAN { 
                    using pins: cmdIn : MotorCommand ; cmdOut : MotorCommand ; 
                }
                passCmdSa : PassMotorCommandAN { 
                    using pins: cmdIn : MotorCommand ; cmdOut : MotorCommand ; 
                }
                passCmdSpe : PassMotorCommandAN { 
                    using pins: cmdIn : MotorCommand ; cmdOut : MotorCommand ; 
                }
                passCmdSpd : PassMotorCommandAN { 
                    using pins: cmdIn : MotorCommand ; cmdOut : MotorCommand ; 
                }

            // Distribui��o isom�rfica de controle para os 4 atuadores f�sicos
            delegate sysCmd to cmdIn
            delegate envGrabT to cmdOut
            
            delegate sysCmd to cmdIn
            delegate envGrabSa to cmdOut

            delegate sysCmd to cmdIn
            delegate envGrabSpe to cmdOut

            delegate sysCmd to cmdIn
            delegate envGrabSpd to cmdOut
        }
    }
}

// BOUNDARYEXECUTION (Isolating boundary Execution Semantics)
package BoundaryExecution {
    import SysADL.types;

    executable def PassBooleanEX ( in boolIn : Boolean ) : out Boolean {
        return boolIn ;
    }

    executable def PassIntEX ( in intIn : Int ) : out Int {
        return intIn ;
    }

    executable def PassNavColorEX ( in colorIn : NavColor ) : out NavColor {
        return colorIn ;
    }

    executable def PassPieceColorEX ( in pColorIn : PieceColor ) : out PieceColor {
        return pColorIn ;
    }

    executable def PassDirectionEX ( in dirIn : Direction ) : out Direction {
        return dirIn ;
    }

    executable def PassMotorCommandEX ( in cmdIn : MotorCommand ) : out MotorCommand {
        return cmdIn ;
    }

    executable def PassMissionParameterEX ( in paramIn : MissionParameter ) : out MissionParameter {
        return paramIn ;
    }

    executable def PassStrategyParameterEX ( in strategyIn : StrategyParameter ) : out StrategyParameter {
        return strategyIn ;
    }

    // Mathematical loop simulator: maps trajectories to floor markers for closed-loop validation
    executable def MapDirectionToColorEX ( in dirIn : Direction ) : out NavColor {
        if (dirIn == Direction::Forward) {
            return NavColor::Black ;
        }
        if (dirIn == Direction::Left) {
            return NavColor::Green ;
        }
        if (dirIn == Direction::Right) {
            return NavColor::Red ;
        }
        return NavColor::None ;
    }

    // NOVO: Execut�vel de Multiplexa��o das raias de carga
    executable def MultiplexPieceColorEX ( 
        in colorT : PieceColor , 
        in colorSa : PieceColor , 
        in colorSpe : PieceColor 
    ) : out PieceColor {
        if (colorT != PieceColor::None) {
            return colorT ;
        }
        if (colorSa != PieceColor::None) {
            return colorSa ;
        }
        if (colorSpe != PieceColor::None) {
            return colorSpe ;
        }
        return PieceColor::None ;
    }

    // NOVO: Execut�vel de Transdu��o de Alarme de Zona
    executable def ProcessZoneAlarmEX ( in zoneColor : NavColor ) : out Boolean {
        if (zoneColor == NavColor::Black) {
            return true ;
        }
        return false ;
    }

}

// REQUIREMENTS & STRICT TRI-PARTITE TRACEABILITY (verified by clauses)

Requirement SortAndTransportFR ( 1.0 ) {
	text = "The RobAFIS system must autonomously retrieve, sort, transport, and store pieces of type P1 (blue spheres) and P2 (red spheres) of 52mm diameter in the production atelier."
}

Requirement ConfigureMissionFR ( 1.1 ) {
	text = "Must be able to read and configure the mission parameter p (P0 or P1) at the beginning of the mission."
	satisfied by SysADL.Components::ParameterInputCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive SortAndTransportFR ;
}

Requirement SelectStrategyFR ( 1.2 ) {
	text = "Must be able to read and configure the initial production strategy (T_First or SPE_First) at startup to determine whether to prioritize clearing the shared entry stock SPE or the nominal trans-elevator T."
	satisfied by SysADL.Components::ParameterInputCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive SortAndTransportFR ;
}

Requirement IdentifyPieceColorFR ( 1.3 ) {
	text = "Must be able to identify the physical color of the 52mm spheres (Blue or Red) or detect their absence using the camera."
	satisfied by SysADL.Components::CameraSensorCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_PriorityResolution_P0_Blue_SPE_Occupied ,
		PkgScenarios.Scenario_PriorityResolution_P1_Red_SPE_Occupied
	] ;
	derive SortAndTransportFR ;
}

Requirement DetectObstacleFR ( 1.4 ) {
	text = "Must be able to detect the presence or absence of physical obstacles or obstructions in the path to prevent collisions."
	satisfied by SysADL.Components::ObstacleSensorCP [
		verified by PkgScenarios.Scenario_Obstacle_Encounter_During_Transit
	] ;
	derive SortAndTransportFR ;
}

Requirement DecideRouteFR ( 1.5 ) {
	text = "Must be able to logically decide the correct route and trajectory to the target stock (SA or SPD) based on the piece color, active mission parameter, and configured production strategy."
	satisfied by SysADL.Components::NavigatorCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive SortAndTransportFR ;
}

Requirement ExecutePriorityLogicFR ( 1.6 ) {
	text = "Must be able to logically override the nominal routing to prioritize grabbing a piece in the SPE buffer within 2 minutes of its appearance to prevent locking the neighboring unit."
	satisfied by SysADL.Components::CargoHandlerCP [
		verified by PkgScenarios.Scenario_PriorityResolution_P0_Blue_SPE_Occupied ,
		PkgScenarios.Scenario_PriorityResolution_P1_Red_SPE_Occupied
	] ;
	derive SortAndTransportFR ;
}

Requirement ManipulatePieceFR ( 1.7 ) {
	text = "Must be able to physically retrieve and release a 52mm sphere from/to the storage calhas using the grabber mechanism without loss."
	satisfied by SysADL.Components::GrabberCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_PriorityResolution_P0_Blue_SPE_Occupied ,
		PkgScenarios.Scenario_PriorityResolution_P1_Red_SPE_Occupied
	] ;
	derive SortAndTransportFR ;
}

Requirement NavigateAutonomouslyFR ( 1.8 ) {
	text = "Must be able to autonomously follow mat black lines of 20mm width and detect green or red color pads of 50mm diameter to control stops and turns."
	derive SortAndTransportFR ;
}

Requirement CorrectTrajectoryFR ( 1.8.1 ) {
	text = "Must be able to measure lateral line offset relative to the robot's center and apply proportional steering corrections to ensure stable line-following."
	satisfied by SysADL.Components::CameraSensorCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ,
	SysADL.Components::DriveSystemCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive NavigateAutonomouslyFR ;
}

Requirement DetectNavigationPadsFR ( 1.8.2 ) {
	text = "Must be able to detect green or red color pads of 50mm diameter on the floor to trigger routing and parking maneuvers."
	satisfied by SysADL.Components::CameraSensorCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive NavigateAutonomouslyFR ;
}

Requirement ReturnToStandbyFR ( 1.9 ) {
	text = "Must be able to automatically return to the standby position PA and halt when the trans-elevator T and the SPE are both empty."
	satisfied by SysADL.Components::NavigatorCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive SortAndTransportFR ;
}

Requirement HaltOnFullStockFR ( 1.10 ) {
	text = "Must autonomously halt and enter a synchronous standby waiting state when the target destination stock (SA or SPD) is fully occupied (3 pieces), resuming operations only when a position is freed."
	satisfied by SysADL.Components::NavigatorCP [
		verified by PkgScenarios.Scenario_Destination_Full_Standby
	] ;
	derive SortAndTransportFR ;
}

Requirement SystemConstraintsNFR ( 2.0 ) {
	text = "The system must comply with all operational, performance, and safety constraints of the atelier."
}

Requirement MaintenanceNFR ( 2.1 ) {
	text = "Must execute the entire mission without requiring any preventive or curative maintenance during operation."
	satisfied by SysADL.Components::RobAFISSystemCP ;
	derive SystemConstraintsNFR ;
}

Requirement SafetyZoneNFR ( 2.2 ) {
	text = "The RobAFIS system must maintain complete safety boundaries and avoid entering Forbidden machine zones."
	derive SystemConstraintsNFR ;
}

Requirement DetectZoneLimitNFR ( 2.2.1 ) {
	text = "Must detect the boundaries of the forbidden mat black machine zones by identifying when the detected black area width significantly exceeds the 20mm line threshold."
	satisfied by SysADL.Components::CameraSensorCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive SafetyZoneNFR ;
}

Requirement AvoidZoneNFR ( 2.2.2 ) {
	text = "Must prevent the robot's wheels or tracks from entering the forbidden machine zones by initiating an immediate emergency stop upon boundary detection."
	satisfied by SysADL.Components::DriveSystemCP [
		verified by PkgScenarios.Scenario_Mission_P0_Blue_Nominal_SPE_Empty ,
		PkgScenarios.Scenario_Mission_P1_Red_Nominal_SPE_Empty
	] ;
	derive SafetyZoneNFR ;
}

Requirement MissionTimeNFR ( 2.3 ) {
	text = "Must be able to complete the nominal sorting and transport mission within a maximum time of 4 minutes."
	satisfied by SysADL.Components::RobAFISSystemCP ;
	derive SystemConstraintsNFR ;
}

Requirement PriorityTimeNFR ( 2.4 ) {
	text = "The RobAFIS system must meet strict execution and travel time budgets for priority SPE operations."
	derive SystemConstraintsNFR ;
}

Requirement PriorityRoutingTimeNFR ( 2.4.1 ) {
	text = "Must be able to process the SPE priority interrupt and calculate the new route within the allocated time budget."
	satisfied by SysADL.Components::CargoHandlerCP [
		verified by PkgScenarios.Scenario_PriorityResolution_P0_Blue_SPE_Occupied ,
		PkgScenarios.Scenario_PriorityResolution_P1_Red_SPE_Occupied
	] ;
	derive PriorityTimeNFR ;
}

Requirement PriorityTravelTimeNFR ( 2.4.2 ) {
	text = "Must be able to transit to the SPE location within the overall priority time budget."
	satisfied by SysADL.Components::DriveSystemCP [
		verified by PkgScenarios.Scenario_PriorityResolution_P0_Blue_SPE_Occupied ,
		PkgScenarios.Scenario_PriorityResolution_P1_Red_SPE_Occupied
	] ;
	derive PriorityTimeNFR ;
}

Requirement PriorityExtractionTimeNFR ( 2.4.3 ) {
	text = "Must be able to physically extract the priority piece from the SPE buffer within the overall priority time budget."
	satisfied by SysADL.Components::GrabberCP [
		verified by PkgScenarios.Scenario_PriorityResolution_P0_Blue_SPE_Occupied ,
		PkgScenarios.Scenario_PriorityResolution_P1_Red_SPE_Occupied
	] ;
	derive PriorityTimeNFR ;
}

Requirement AutonomyNFR ( 2.5 ) {
	text = "Must operate completely autonomously without remote control or human intervention after the initial start signal."
	satisfied by SysADL.Components::RobAFISControllerCP ;
	derive SystemConstraintsNFR ;
}


// VALIDATION PLAN (Unified package containing Signals, Activities, Scenes & Scenarios)

package PkgScenarios {
    import SysADL.types ;
    import EnvPortsRobAFIS ;
    import EnvConnectorsRobAFIS ;
    import EnvComponentsRobAFIS ;

    EnvActivitiesDefinitions RobAFISEnvironmentActivities {
        // Signals
        signal def StartSimulationSig { attributes : mission : MissionParameter ; strategy : StrategyParameter ; }
        signal def SetMissionParamSig { attributes : param : MissionParameter ; strategy : StrategyParameter ; }
        signal def LineOffsetChangedSig { attributes : offset : Int ; }
        signal def ObstacleDetectedSig {}
        signal def ObstacleRemovedSig {}
        signal def ZoneAlarmTriggeredSig {}
        signal def GrabPieceSig { attributes : pieceColor : PieceColor ; }
        signal def DropPieceSig {}
        signal def LeftPASig {}
        signal def UnitArrivedAtTSig {}
        signal def UnitArrivedAtSPESig {}
        signal def TargetReachedSig {}
        signal def ExposePieceTSig { attributes : pieceColor : PieceColor ; }
        signal def ExposePieceSPESig { attributes : pieceColor : PieceColor ; }
        signal def ExtractedPieceTSig {}
        signal def ExtractedPieceSPESig {}
        signal def RoutedToSASig {}
        signal def RoutedToSPDSig {}
        signal def DetectedGreenPadSig {}
        signal def DetectedRedPadSig {}
        signal def TurnedRightSig {}
        signal def ArrivedAtPASig {}
        signal def RouteToSASig {}
        signal def RouteToSPDSig {}
        signal def StopAtSPESig {}
        signal def ExtractPiecePESig { attributes : pieceColor : PieceColor ; }

        // Actions
        EnvAction def PassMissionParameterAN ( paramIn : MissionParameter ) : MissionParameter {}
        EnvAction def PassStrategyParameterAN ( strategyIn : StrategyParameter ) : StrategyParameter {}
        EnvAction def PassNavColorAN ( colorIn : NavColor ) : NavColor {}
        EnvAction def PassIntAN ( intIn : Int ) : Int {}
        EnvAction def PassBooleanAN ( boolIn : Boolean ) : Boolean {}
        EnvAction def PassPieceColorAN ( colorIn : PieceColor ) : PieceColor {}

        // Operator Environment Activity
        EnvActivity def OperatorEA () : ( opParamOut : MissionParameter , opStratOut : StrategyParameter ) {
            body {
                actions:
                    setMissionParametersOp : PassMissionParameterAN { using pins: paramIn : MissionParameter ; }
                    setStrategyOp : PassStrategyParameterAN { using pins: strategyIn : StrategyParameter ; }
                delegate opParamOut to setMissionParametersOp
                delegate opStratOut to setStrategyOp

                ON StartSimulationSig
                THEN setMissionParametersOp { paramIn = StartSimulationSig.mission ; }
                SEND SetMissionParamSig { param = StartSimulationSig.mission ; strategy = StartSimulationSig.strategy ; }
            }
        }

        // Unit Environment Activity
        EnvActivity def UnitEA (
            inOpParam : MissionParameter ,
            inOpStrategy : StrategyParameter ,
            inLineOffset : Int ,
            inObstacle : Boolean ,
            inZoneAlarm : Boolean ,
            inTPieceColor : PieceColor ,
            inSPEPieceColor : PieceColor
        ) : (
            outUnitNavLine : NavColor ,
            outUnitNavPad : NavColor ,
            outUnitPieceColor : PieceColor ,
            outSPEPieceColor : PieceColor ,
            outUnitLineOffset : Int ,
            outUnitZoneAlarm : Boolean ,
            outUnitObstacle : Boolean
        ) {
            body {
                actions:
                    leavePA : PassNavColorAN { using pins: colorIn : NavColor ; }
                    detectGreenPad : PassNavColorAN { using pins: colorIn : NavColor ; }
                    turnRight : PassNavColorAN { using pins: colorIn : NavColor ; }
                    detectRedPad : PassNavColorAN { using pins: colorIn : NavColor ; }
                    stopAtT : PassNavColorAN { using pins: colorIn : NavColor ; }
                    routeToSA : PassNavColorAN { using pins: colorIn : NavColor ; }
                    routeToSPD : PassNavColorAN { using pins: colorIn : NavColor ; }
                    stopAtSPE : PassNavColorAN { using pins: colorIn : NavColor ; }
                    arriveAtTargetStock : PassNavColorAN { using pins: colorIn : NavColor ; }
                    returnJourney : PassNavColorAN { using pins: colorIn : NavColor ; }
                    arriveAtPA : PassNavColorAN { using pins: colorIn : NavColor ; }
                    acknowledgeTarget : PassNavColorAN { using pins: colorIn : NavColor ; }
                    extractPieceT : PassPieceColorAN { using pins: pieceIn : PieceColor ; }
                    extractPieceSPE : PassPieceColorAN { using pins: pieceIn : PieceColor ; }
                    insertPieceSA : PassPieceColorAN { using pins: pieceIn : PieceColor ; }
                    insertPieceSPD : PassPieceColorAN { using pins: pieceIn : PieceColor ; }
                    exposePieceT : PassPieceColorAN { using pins: pieceIn : PieceColor ; }
                    exposePieceSPE : PassPieceColorAN { using pins: pieceIn : PieceColor ; }
                    setObstacleTrue : PassBooleanAN { using pins: boolIn : Boolean ; }
                    setObstacleFalse : PassBooleanAN { using pins: boolIn : Boolean ; }

                delegate outUnitNavLine to leavePA
                delegate outUnitNavLine to turnRight
                delegate outUnitNavLine to returnJourney
                delegate outUnitNavPad to detectGreenPad
                delegate outUnitNavPad to detectRedPad
                delegate outUnitNavPad to stopAtT
                delegate outUnitNavPad to routeToSA
                delegate outUnitNavPad to routeToSPD
                delegate outUnitNavPad to stopAtSPE
                delegate outUnitNavPad to arriveAtTargetStock
                delegate outUnitPieceColor to extractPieceT
                delegate outSPEPieceColor to extractPieceSPE
                delegate outUnitObstacle to setObstacleTrue
                delegate outUnitObstacle to setObstacleFalse

                ON LeftPASig
                THEN leavePA { colorIn = NavColor::Black ; }

                ON UnitArrivedAtTSig
                THEN stopAtT { colorIn = NavColor::Red ; }

                ON ExposePieceTSig
                THEN exposePieceT { pieceIn = ExposePieceTSig.pieceColor ; }

                ON GrabPieceSig
                THEN extractPieceT { pieceIn = PieceColor::None ; }

                ON RoutedToSASig
                THEN routeToSA { colorIn = NavColor::Black ; }

                ON RoutedToSPDSig
                THEN routeToSPD { colorIn = NavColor::Black ; }

                ON DetectedGreenPadSig
                THEN detectGreenPad { colorIn = NavColor::Green ; }

                ON TurnedRightSig
                THEN turnRight { colorIn = NavColor::Black ; }

                ON DetectedRedPadSig
                THEN detectRedPad { colorIn = NavColor::Red ; }

                ON TargetReachedSig
                THEN arriveAtTargetStock { colorIn = NavColor::Green ; }

                ON DropPieceSig
                THEN insertPieceSA { pieceIn = PieceColor::Blue ; }

                ON ArrivedAtPASig
                THEN arriveAtPA { colorIn = NavColor::Black ; }

                ON ObstacleDetectedSig
                THEN setObstacleTrue { boolIn = true ; }

                ON ObstacleRemovedSig
                THEN setObstacleFalse { boolIn = false ; }
            }
        }
    }

    SceneDefinitions RobAFISScenes to RobAFISEnvironmentActivities {
        // --- UNIT 1 SCENES ---
        Scene def SCN_ObstacleStop_Unit1 {
            precondition { unit1.navLine.outColor == NavColor::Black ; }
            start ObstacleDetectedSig ;
            finish ObstacleDetectedSig ;
            postcondition { unit1.obstacle.outObstacle == true ; }
        }

        Scene def SCN_ObstacleResume_Unit1 {
            start ObstacleRemovedSig ;
            finish ObstacleRemovedSig ;
            postcondition { unit1.obstacle.outObstacle == false ; }
        }

        Scene def SCN_ReadParam_P0_Unit1 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { unit1.unit_pInput.inParam == MissionParameter::P0 ; }
        }

        Scene def SCN_ReadParam_P1_Unit1 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { unit1.unit_pInput.inParam == MissionParameter::P1 ; }
        }

        Scene def SCN_IdentifyPiece_T_Blue_Unit1 {
            precondition { unit1.transElevator.outPieceColor == PieceColor::Blue ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
            postcondition { unit1.unit_camera.inPieceColor == PieceColor::Blue ; }
        }

        Scene def SCN_IdentifyPiece_T_Red_Unit1 {
            precondition { unit1.transElevator.outPieceColor == PieceColor::Red ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
            postcondition { unit1.unit_camera.inPieceColor == PieceColor::Red ; }
        }

        Scene def SCN_GrabPiece_T_Unit1 {
            precondition { unit1.transElevator.outPieceColor != PieceColor::None ; }
            start ExposePieceTSig ;
            finish GrabPieceTSig ;
            postcondition { unit1.transElevator.outPieceColor == PieceColor::None ; }
        }

        Scene def SCN_DecideRoute_SA_P0_Blue_Unit1 {
            precondition { unit1.unit_pInput.inParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P0_Red_Unit1 {
            precondition { unit1.unit_pInput.inParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_DecideRoute_SA_P1_Red_Unit1 {
            precondition { unit1.unit_pInput.inParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P1_Blue_Unit1 {
            precondition { unit1.unit_pInput.inParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_SPEArrival_Unit1 {
            precondition { spe1_spd2.outPieceColor != PieceColor::None ; }
            start StopAtSPESig ;
            finish ExtractPiecePESig ;
            postcondition { unit1.unit_camera.inSpePieceColor != PieceColor::None ; }
        }

        Scene def SCN_Priority_Route_Target_Unit1 {
            start ExtractPiecePESig ;
            finish TargetReachedSig ;
            postcondition { unit1.navPad.outColor == NavColor::Green ; }
        }

        Scene def SCN_SkipSPE_Empty_To_Target_Unit1 {
            precondition { spe1_spd2.outPieceColor == PieceColor::None ; }
            start RouteToSASig ;
            finish RouteToSASig ;
        }

        Scene def SCN_ReleasePiece_SA_Unit1 {
            start RouteToSASig ;
            finish DropPieceSig ;
            postcondition { unit1.arrivalStock.outPieceColor != PieceColor::None ; }
        }

        Scene def SCN_ReturnJourney_From_Target_to_PA_Unit1 {
            start DropPieceSig ;
            finish ArrivedAtPASig ;
            postcondition { unit1.standbyPos.outColor == NavColor::Black ; }
        }


        // --- UNIT 2 SCENES ---
        Scene def SCN_ObstacleStop_Unit2 {
            precondition { unit2.navLine.outColor == NavColor::Black ; }
            start ObstacleDetectedSig ;
            finish ObstacleDetectedSig ;
            postcondition { unit2.obstacle.outObstacle == true ; }
        }

        Scene def SCN_ObstacleResume_Unit2 {
            start ObstacleRemovedSig ;
            finish ObstacleRemovedSig ;
            postcondition { unit2.obstacle.outObstacle == false ; }
        }

        Scene def SCN_ReadParam_P0_Unit2 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { unit2.unit_pInput.inParam == MissionParameter::P0 ; }
        }

        Scene def SCN_ReadParam_P1_Unit2 {
            start StartSimulationSig ;
            finish SetMissionParamSig ;
            postcondition { unit2.unit_pInput.inParam == MissionParameter::P1 ; }
        }

        Scene def SCN_IdentifyPiece_T_Blue_Unit2 {
            precondition { unit2.transElevator.outPieceColor == PieceColor::Blue ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
            postcondition { unit2.unit_camera.inPieceColor == PieceColor::Blue ; }
        }

        Scene def SCN_IdentifyPiece_T_Red_Unit2 {
            precondition { unit2.transElevator.outPieceColor == PieceColor::Red ; }
            start ExposePieceTSig ;
            finish ExposePieceTSig ;
            postcondition { unit2.unit_camera.inPieceColor == PieceColor::Red ; }
        }

        Scene def SCN_GrabPiece_T_Unit2 {
            precondition { unit2.transElevator.outPieceColor != PieceColor::None ; }
            start ExposePieceTSig ;
            finish GrabPieceTSig ;
            postcondition { unit2.transElevator.outPieceColor == PieceColor::None ; }
        }

        Scene def SCN_DecideRoute_SA_P0_Blue_Unit2 {
            precondition { unit2.unit_pInput.inParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P0_Red_Unit2 {
            precondition { unit2.unit_pInput.inParam == MissionParameter::P0 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_DecideRoute_SA_P1_Red_Unit2 {
            precondition { unit2.unit_pInput.inParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSASig ;
        }

        Scene def SCN_DecideRoute_SPD_P1_Blue_Unit2 {
            precondition { unit2.unit_pInput.inParam == MissionParameter::P1 ; }
            start GrabPieceTSig ;
            finish RouteToSPDSig ;
        }

        Scene def SCN_SPEArrival_Unit2 {
            precondition { spd1_spe2.outPieceColor != PieceColor::None ; }
            start StopAtSPESig ;
            finish ExtractPiecePESig ;
            postcondition { unit2.unit_camera.inSpePieceColor != PieceColor::None ; }
        }

        Scene def SCN_Priority_Route_Target_Unit2 {
            start ExtractPiecePESig ;
            finish TargetReachedSig ;
            postcondition { unit2.navPad.outColor == NavColor::Green ; }
        }

        Scene def SCN_SkipSPE_Empty_To_Target_Unit2 {
            precondition { spd1_spe2.outPieceColor == PieceColor::None ; }
            start RouteToSASig ;
            finish RouteToSASig ;
        }

        Scene def SCN_ReleasePiece_SA_Unit2 {
            start RouteToSASig ;
            finish DropPieceSig ;
            postcondition { unit2.arrivalStock.outPieceColor != PieceColor::None ; }
        }

        Scene def SCN_ReturnJourney_From_Target_to_PA_Unit2 {
            start DropPieceSig ;
            finish ArrivedAtPASig ;
            postcondition { unit2.standbyPos.outColor == NavColor::Black ; }
        }
    }

    ScenarioDefinitions ValidationPlan_RobAFIS to RobAFISScenes {
        // --- UNIT 1 SCENARIOS ---
        Scenario def Scenario_Obstacle_Encounter_During_Transit {
            SCN_ObstacleStop_Unit1 ;
            SCN_ObstacleResume_Unit1 ;
        }

        Scenario def Scenario_Mission_P0_Blue_Nominal_SPE_Empty {
            SCN_ReadParam_P0_Unit1 ;
            SCN_IdentifyPiece_T_Blue_Unit1 ;
            SCN_GrabPiece_T_Unit1 ;
            SCN_DecideRoute_SA_P0_Blue_Unit1 ;
            SCN_SkipSPE_Empty_To_Target_Unit1 ;
            SCN_ReleasePiece_SA_Unit1 ;
            SCN_ReturnJourney_From_Target_to_PA_Unit1 ;
        }

        Scenario def Scenario_Mission_P1_Red_Nominal_SPE_Empty {
            SCN_ReadParam_P1_Unit1 ;
            SCN_IdentifyPiece_T_Red_Unit1 ;
            SCN_GrabPiece_T_Unit1 ;
            SCN_DecideRoute_SA_P1_Red_Unit1 ;
            SCN_SkipSPE_Empty_To_Target_Unit1 ;
            SCN_ReleasePiece_SA_Unit1 ;
            SCN_ReturnJourney_From_Target_to_PA_Unit1 ;
        }

        Scenario def Scenario_PriorityResolution_P0_Blue_SPE_Occupied {
            SCN_ReadParam_P0_Unit1 ;
            SCN_SPEArrival_Unit1 ;
            SCN_Priority_Route_Target_Unit1 ;
            SCN_ReleasePiece_SA_Unit1 ;
            SCN_ReturnJourney_From_Target_to_PA_Unit1 ;
        }


        // --- UNIT 2 SCENARIOS ---
        Scenario def Scenario_Obstacle_Encounter_Unit2 {
            SCN_ObstacleStop_Unit2 ;
            SCN_ObstacleResume_Unit2 ;
        }

        Scenario def Scenario_Mission_P0_Blue_Nominal_SPE_Empty_Unit2 {
            SCN_ReadParam_P0_Unit2 ;
            SCN_IdentifyPiece_T_Blue_Unit2 ;
            SCN_GrabPiece_T_Unit2 ;
            SCN_DecideRoute_SA_P0_Blue_Unit2 ;
            SCN_SkipSPE_Empty_To_Target_Unit2 ;
            SCN_ReleasePiece_SA_Unit2 ;
            SCN_ReturnJourney_From_Target_to_PA_Unit2 ;
        }

        Scenario def Scenario_Mission_P1_Red_Nominal_SPE_Empty_Unit2 {
            SCN_ReadParam_P1_Unit2 ;
            SCN_IdentifyPiece_T_Red_Unit2 ;
            SCN_GrabPiece_T_Unit2 ;
            SCN_DecideRoute_SA_P1_Red_Unit2 ;
            SCN_SkipSPE_Empty_To_Target_Unit2 ;
            SCN_ReleasePiece_SA_Unit2 ;
            SCN_ReturnJourney_From_Target_to_PA_Unit2 ;
        }

        Scenario def Scenario_PriorityResolution_P1_Red_SPE_Occupied {
            SCN_ReadParam_P1_Unit2 ;
            SCN_SPEArrival_Unit2 ;
            SCN_Priority_Route_Target_Unit2 ;
            SCN_ReleasePiece_SA_Unit2 ;
            SCN_ReturnJourney_From_Target_to_PA_Unit2 ;
        }

        Scenario def Scenario_Destination_Full_Standby {
            SCN_ReadParam_P0_Unit1 ;
        }
    }

    ScenarioExecution ScenarioExecution_P0_T_First_Obstacle to ValidationPlan_RobAFIS {
        mode: once ;

        inject StartSimulationSig {
            mission = MissionParameter::P0 ;
            strategy = StrategyParameter::T_First ;
        } immediate ;

        inject ObstacleDetectedSig when unit1.navPad.outColor == NavColor::Green ;
        inject ObstacleRemovedSig after 100 ;

        // Unit 1 Inventory (Both full): Prioritizes SPE (Blue), then takes T (Blue).
        unit1.transElevator.outPieceColor = PieceColor::Blue ;
        spe1_spd2.outPieceColor = PieceColor::Blue ;

        // Unit 2 Inventory (Both full): Prioritizes SPE (Red), then takes T (Blue).
        unit2.transElevator.outPieceColor = PieceColor::Blue ;
        spd1_spe2.outPieceColor = PieceColor::Red ;

        parallel {
            Scenario_PriorityResolution_P0_Blue_SPE_Occupied ;
            Scenario_Obstacle_Encounter_During_Transit ;
            Scenario_Mission_P0_Blue_Nominal_SPE_Empty ;
            Scenario_PriorityResolution_P1_Red_SPE_Occupied ;
            Scenario_Obstacle_Encounter_Unit2 ;
            Scenario_Mission_P0_Blue_Nominal_SPE_Empty_Unit2 ;
        }
    }
}

allocations {
    envActivity OperatorEA to HumanOperatorEnvCP
    envActivity UnitEA to ProductionUnitEnvCP
    activity SysADL.Behavior::MissionPlannerAC to SysADL.Components::MissionPlannerCP
    activity SysADL.Behavior::NavigatorAC to SysADL.Components::NavigatorCP
    activity SysADL.Behavior::CargoHandlerAC to SysADL.Components::CargoHandlerCP
    activity SysADL.Behavior::RobAFISControllerAC to SysADL.Components::RobAFISControllerCP
    activity BoundaryBehavior::ParameterInputAC to SysADL.Components::ParameterInputCP
    activity BoundaryBehavior::CameraSensorAC to SysADL.Components::CameraSensorCP
    activity BoundaryBehavior::ObstacleSensorAC to SysADL.Components::ObstacleSensorCP
    activity BoundaryBehavior::DriveSystemAC to SysADL.Components::DriveSystemCP
    activity BoundaryBehavior::GrabberAC to SysADL.Components::GrabberCP
    executable SysADL.Execution::ConfigureMissionEX to SysADL.Behavior::ConfigureMissionAN
    executable SysADL.Execution::DecideCommandEX to SysADL.Behavior::DecideCommandAN
    executable SysADL.Execution::ExtractDirEX to SysADL.Behavior::ExtractDirAN
    executable SysADL.Execution::VerifyCargoEX to SysADL.Behavior::VerifyCargoAN
    executable SysADL.Execution::ExtractGrabEX to SysADL.Behavior::ExtractGrabAN
    executable BoundaryExecution::PassBooleanEX to BoundaryActions::PassBooleanAN
    executable BoundaryExecution::PassIntEX to BoundaryActions::PassIntAN
    executable BoundaryExecution::PassNavColorEX to BoundaryActions::PassNavColorAN
    executable BoundaryExecution::PassPieceColorEX to BoundaryActions::PassPieceColorAN
    executable BoundaryExecution::PassDirectionEX to BoundaryActions::PassDirectionAN
    executable BoundaryExecution::PassMotorCommandEX to BoundaryActions::PassMotorCommandAN
    executable BoundaryExecution::PassMissionParameterEX to BoundaryActions::PassMissionParameterAN
    executable BoundaryExecution::PassStrategyParameterEX to BoundaryActions::PassStrategyParameterAN
    executable BoundaryExecution::MultiplexPieceColorEX to BoundaryActions::MultiplexPieceColorAN
    executable BoundaryExecution::ProcessZoneAlarmEX to BoundaryActions::ProcessZoneAlarmAN
}
