    {
      "type": "Requirement",
      "name": "CheckAirConditioningStatus",
      "id": "2.3",
      "text": "The system must detect whether the air conditioners are switched on or off.",
      "satisfiedBy": null,
      "derive": {
        "type": "QualifiedNameList",
        "items": [
          "SmartPlace.AirConditioningControl.TurnOn_TurnOff_AirConditioning.TurnOnAirConditioning"
