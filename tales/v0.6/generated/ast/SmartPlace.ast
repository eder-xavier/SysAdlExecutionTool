      "name": "CheckRoomReservation",
      "id": "2.5",
      "text": "The system should consult the Reservation Manager to check if there is a reservation for a particular room within the next 15 minutes.",
      "satisfiedBy": null,
      "derive": {
        "type": "QualifiedNameList",
        "items": [
          "SmartPlace.AirConditioningControl.TurnOn_TurnOff_AirConditioning.TurnOffAirConditioning"
