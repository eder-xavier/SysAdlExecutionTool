                {
                  "type": "ConnectorUse",
                  "name": "command",
                  "definition": "commandArm",
                  "bounds": null,
                  "bindings": [
                    "bindings",
                    [
                      " "
                    ],
                    {
                      "type": "ConnectorBindingList",
                      "items": [
                        {
                          "type": "ConnectorBinding",
                          "source": "cmd_sm",
