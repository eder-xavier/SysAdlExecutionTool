          "returnType": "Boolean",
          "properties": [],
          "body": [
            {
              "type": "IfBlockStatement",
              "main_if": {
                "type": "IfStatement",
                "condition": {
                  "type": "BinaryExpression",
                  "operator": "&&",
                  "left": {
                    "type": "BinaryExpression",
