        {
          "type": "ComponentDef",
          "isBoundary": false,
          "name": "AGVSystem",
          "appliedStyle": null,
          "abstractComponent": null,
          "ports": [
            {
              "type": "PortUse",
              "name": "sendStatus",
              "definition": "outStatus",
