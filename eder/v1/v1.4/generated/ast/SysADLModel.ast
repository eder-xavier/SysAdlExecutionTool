            }
          }
        },
        {
          "type": "ActivityDef",
          "name": "EVENTUserInterfaceAC",
          "implements": [],
          "inParameters": [
            [
              {
                "type": "Pin",
                "name": "inDesired",
                "isFlow": false,
                "definition": "CelsiusTemperature",
