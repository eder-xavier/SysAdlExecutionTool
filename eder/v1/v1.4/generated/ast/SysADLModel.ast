            }
          }
        },
        {
          "type": "ActivityDef",
          "name": "CalculateAverageTemperatureAC",
          "implements": [],
          "inParameters": [
            [
              {
                "type": "Pin",
                "name": "s1",
                "isFlow": false,
                "definition": "CelsiusTemperature",
