            }
          }
        },
        {
          "type": "ActivityDef",
          "name": "DecideCommandAC",
          "implements": [],
          "inParameters": [
            [
              {
                "type": "Pin",
                "name": "average2",
                "isFlow": false,
                "definition": "CelsiusTemperature",
