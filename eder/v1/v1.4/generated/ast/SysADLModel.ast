            }
          }
        },
        {
          "type": "ActivityDef",
          "name": "EVENTPresenceSensorAC",
          "implements": [],
          "inParameters": [
            [
              {
                "type": "Pin",
                "name": "inDetect",
                "isFlow": false,
                "definition": "Boolean",
