            "source": {
              "source": "/Users/tales/desenv/SysAdlWebStudio/eder/v1/v1.4/temp/SysADLModel.sysadl",
              "text": "\tModel SysADLModel ; \n\tpackage types {\n\t  value type Int {}\n\t  value type Boolean {}\n\t  value type String {}\n\t  value type Void {}\n\t  value type Real {}\n\t  enum Command {On , Off }\n\t  datatype Commands {attributes : heater : Command ; cooler : Command ; }\n\t  dimension Temperature unit Celsius {dimension = Temperature }\n\t  unit Fahrenheit {dimension = Temperature }\n\t  value type temperature extends Real { dimension = Temperature }\n\t  value type FahrenheitTemperature extends temperature { unit = Fahrenheit dimension = Temperature }\n\t  value type CelsiusTemperature extends temperature { unit = Celsius dimension = Temperature } \n\t}\n\tpackage Ports { \n\t  import types ; \n\t  port def FTemperatureOPT { flow out FahrenheitTemperature }\n\t  port def PresenceIPT { flow in Boolean }\n\t  port def PresenceOPT { flow out Boolean }\n\t  port def CTemperatureIPT { flow in CelsiusTemperature }\n\t  port def CommandIPT { flow in Command }\n\t  port def CommandOPT { flow out Command }\n\t  port def CTemperatureOPT { flow out CelsiusTemperature }\n\tport def FTemperatureIPT { flow in FahrenheitTemperature } }\n\tpackage Connectors { \n\t  \timport types ; \n\t  \timport Ports ; \n\t  \tconnector def FahrenheitToCelsiusCN { \n\t  \t\tparticipants : \n\t  \t\t\t~ Ft : FTemperatureOPT ; \n\t  \t\t\t~ Ct : CTemperatureIPT ; \n\t\t\tflows : \n\t\t\t\tFahrenheitTemperature from Ft to Ct\n\t  \t}\n\t  connector def PresenceCN { \n\t  \t\tparticipants : \n\t  \t\t\t~ pOut : PresenceOPT ; \n\t  \t\t\t~ pIn : PresenceIPT ; \n\t  \t\tflows : \n\t  \t\t\tBoolean from pOut to pIn\n\t  }\n\t  connector def CommandCN { \n\t  \t\tparticipants : \n\t  \t\t\t~ commandOut : CommandOPT ; \n\t  \t\t\t~ commandIn : CommandIPT ; \n\t  \t\tflows : \n\t  \t\t\tCommand from commandOut to commandIn\n\t  }\n\t  connector def CTemperatureCN { \n\t  \t\tparticipants : \n\t  \t\t\t~ CtOut : CTemperatureOPT ; \n\t  \t\t\t~ ctIn : CTemperatureIPT ; \n\t  \t\tflows : \n\t  \t\t\tCelsiusTemperature from CtOut to ctIn\n\t  } \n\t  connector def FTemperatureCN { participants : ~ ftOut : FTemperatureOPT ; ~ ftIn : FTemperatureIPT ; flows : FahrenheitTemperature from ftOut to ftIn } \n\t }\n\t  \n\t  package Components { \n\t  \timport Connectors ; \n\t  \timport types ; \n\t  \timport Ports ;\n\t\tcomponent def RTCSystemCFD {\t\n\t\t\t configuration {\t \n\t\t\t \tcomponents : \n\t\t\t \t\tts1 : TemperatureSensorCP {\t using ports : current1 : FTemperatureOPT ; inCurrent1 : FTemperatureIPT ;}\n\t\t  \t\t\tts2 : TemperatureSensorCP {\t using ports : current2 : FTemperatureOPT ; inCurrent2 : FTemperatureIPT ;}\n\t\t  \t\t\tts3 : TemperatureSensorCP {\t using ports : current3 : FTemperatureOPT ; inCurrent3 : FTemperatureIPT ;}\n\t\t  \t\t\tts4 : TemperatureSensorCP {\t using ports : current4 : FTemperatureOPT ; inCurrent4 : FTemperatureIPT ;}\n\t\t\t\t\ts3 : PresenceSensorCP {\t using ports : detected : PresenceOPT ; inDetect : PresenceIPT ; }\n\t\t  \t\t\tui : UserInterfaceCP { using ports : desired : CTemperatureOPT ; inDesired : CTemperatureIPT ; } \n\t\t  \t\t\tac1 : CoolerCP { using ports : controllerC1 : CommandIPT ; cooler1F : FTemperatureOPT ; }\n\t\t  \t\t\tac2 : CoolerCP { using ports : controllerC2 : CommandIPT ; cooler2F : FTemperatureOPT ; } \n\t\t  \t\t\tah1 : HeaterCP { using ports : controllerH1 : CommandIPT ; heater1F : FTemperatureOPT ; }\n\t\t  \t\t\tah2 : HeaterCP { using ports : controllerH2 : CommandIPT ; heater2F : FTemperatureOPT ; }\n\t\t  \t\t\trtc : RoomTemperatureControllerCP {\t \n\t\t  \t\t\t\tusing ports : \n\t\t  \t\t\t\t\tdetected : PresenceIPT ; \n\t\t  \t\t\t\t\tlocalTemp1 : CTemperatureIPT ; \n\t\t  \t\t\t\t\tlocalTemp2 : CTemperatureIPT ; \n\t\t  \t\t\t\t\tlocalTemp3 : CTemperatureIPT ; \n\t\t  \t\t\t\t\tlocalTemp4 : CTemperatureIPT ; \n\t\t  \t\t\t\t\tuserTemp : CTemperatureIPT ; \n\t\t  \t\t\t\t\theating1 : CommandOPT ; \n\t\t  \t\t\t\t\tcooling1 : CommandOPT ; \n\t\t  \t\t\t} \n\t\t  \t\t\tpENV : PersonENV { \n\t\t  \t\t\t\tusing ports : outDesired : CTemperatureOPT ; outPresence : PresenceOPT ;\n\t\t  \t\t\t}\n\t\t  \t\t\trtENV : RoomTemperatureENV { \n\t\t  \t\t\t\tusing ports : \n\t\t  \t\t\t\t\trtIn1 : FTemperatureIPT ; \n\t\t  \t\t\t\t\trtOut1 : FTemperatureOPT ; \n\t\t  \t\t\t\t\trtIn2 : FTemperatureIPT ; \n\t\t  \t\t\t\t\trtOut2 : FTemperatureOPT ; \n\t\t  \t\t\t\t\trtIn3 : FTemperatureIPT ; \n\t\t  \t\t\t\t\trtOut3 : FTemperatureOPT ; \n\t\t  \t\t\t\t\trtIn4 : FTemperatureIPT ; \n\t\t  \t\t\t\t\trtOut4 : FTemperatureOPT ;\n\t\t  \t\t\t} \n\t\t  \t\tconnectors : \n\t\t  \t\t\tuc : CTemperatureCN bindings desired = userTemp ; \n\t\t  \t\t\tcc1 : CommandCN bindings cooling1 = controllerC1 ; \n\t\t  \t\t\tpc : PresenceCN bindings detected = detected ; \n\t\t  \t\t\tc1 : FahrenheitToCelsiusCN bindings current1 = localTemp1 ; \n\t\t  \t\t\tc2 : FahrenheitToCelsiusCN bindings current2 = localTemp2 ; \n\t\t  \t\t\tc3 : FahrenheitToCelsiusCN bindings current3 = localTemp3 ; \n\t\t  \t\t\tc4 : FahrenheitToCelsiusCN bindings current4 = localTemp4 ; \n\t\t  \t\t\tch1 : CommandCN bindings heating1 = controllerH1 ; \n\t\t  \t\t\tpui : CTemperatureCN bindings outDesired = inDesired ; \n\t\t  \t\t\tpp : PresenceCN bindings outPresence = inDetect ; \n\t\t  \t\t\trtt1 : FTemperatureCN bindings rtOut1 = inCurrent1 ; \n\t\t  \t\t\trtt2 : FTemperatureCN bindings rtOut2 = inCurrent2 ; \n\t\t  \t\t\trtt3 : FTemperatureCN bindings rtOut3 = inCurrent3 ; \n\t\t  \t\t\trtt4 : FTemperatureCN bindings rtOut4 = inCurrent4 ; \n\t\t  \t\t\tcrt1 : FTemperatureCN bindings cooler1F = rtIn1 ; \n\t\t  \t\t\thrt1 : FTemperatureCN bindings heater1F = rtIn1 ; \n\t\t  \t\t\tcrt2 : FTemperatureCN bindings cooler1F = rtIn2 ; \n\t\t  \t\t\tcc2 : CommandCN bindings cooling1 = controllerC2 ; \n\t\t  \t\t\tch2 : CommandCN bindings heating1 = controllerH2 ; \n\t\t  \t\t\tht2 : FTemperatureCN bindings heater1F = rtIn2 ; \n\t\t  \t\t\tht3 : FTemperatureCN bindings heater2F = rtIn3 ; \n\t\t  \t\t\tht4 : FTemperatureCN bindings heater2F = rtIn4 ; \n\t\t  \t\t\tcrt3 : FTemperatureCN bindings cooler2F = rtIn3 ; \n\t\t  \t\t\tcrt4 : FTemperatureCN bindings cooler2F = rtIn4 ; \n\t\t  \t\n\t\t  \t\t}\n\t\t  }\n\t\n\t\tcomponent def RoomTemperatureControllerCP {\t \n\t\t\tports : detectedRTC : PresenceIPT ; localTemp1 : CTemperatureIPT ; localTemp2 : CTemperatureIPT ; userTempRTC : CTemperatureIPT ; heatingRTC : CommandOPT ; coolingRTC : CommandOPT ; localTemp3 : CTemperatureIPT ; localTemp4 : CTemperatureIPT ; \n\t\t\tconfiguration {\t \n\t\t\t\tcomponents : \n\t\t\t\t\tsm : SensorsMonitorCP {\t \n\t\t\t\t\t\tusing ports : \n\t\t\t\t\t\t    s1 : CTemperatureIPT ; \n\t\t\t\t\t\t\ts2 : CTemperatureIPT ;\n\t\t\t\t\t\t\ts3 : CTemperatureIPT ; \n\t\t\t\t\t\t\ts4 : CTemperatureIPT ; \n\t\t\t\t\t\t\taverage : CTemperatureOPT ;\n\t\t\t\t\t}\n\t\t  \t\t\tcm : CommanderCP {\t \n\t\t  \t\t\t\tusing ports : \n\t\t  \t\t\t\t\ttarget2 : CTemperatureIPT ; \n\t\t  \t\t\t\t\taverage2 : CTemperatureIPT ; \n\t\t  \t\t\t\t\theating : CommandOPT ; \n\t\t  \t\t\t\t\tcooling : CommandOPT ;\n\t\t  \t\t\t}\n\t\t  \t\t\tpc : PresenceCheckerCP {\t \n\t\t  \t\t\t\tusing ports : \n\t\t  \t\t\t\t\tdetected : PresenceIPT ; \n\t  \t\t\t\t\t\tuserTemp : CTemperatureIPT ; \n\t  \t\t\t\t\t\ttarget : CTemperatureOPT ;\n\t\t  \t\t\t}\n\t\t  \t\tconnectors : \n\t\t  \t\t\ttarget : CTemperatureCN bindings target = target2 ; \n\t\t  \t\t\taverage : CTemperatureCN bindings average = average2 ; \n\t  \t\t\tdelegations :\n\t  \t\t\t\tuserTemp to userTempRTC \n\t  \t\t\t\tdetected to detectedRTC \n\t  \t\t\t\theating to heatingRTC \n\t  \t\t\t\tcooling to coolingRTC \n\t  \t\t\t\ts1 to localTemp1 \n\t  \t\t\t\ts2 to localTemp2 \n\t  \t\t\t\ts3 to localTemp3 \n\t  \t\t\t\ts4 to localTemp4 \n\t  \t\t\t}\n\t\t  } \n\t\tboundary component def TemperatureSensorCP {\t \n\t\t  \t\tports : current : FTemperatureOPT ;\n\t\t  \t\t\t\tinCurrent : FTemperatureIPT ; } \n\t\tboundary component def PresenceSensorCP {\t \n\t\t  \t\tports : detected : PresenceOPT ;\n\t\t  \t\t\t\tinDetect : PresenceIPT ; } \n\t\tboundary component def UserInterfaceCP {\t \n\t\t  \t\tports : desired : CTemperatureOPT ;\n\t\t  \t\t\t\tinDesired : CTemperatureIPT ; } \n\t\tboundary component def HeaterCP {\t \n\t\t  \t\tports : controllerH : CommandIPT ;\n\t\t  \t\t\t\theaterF : FTemperatureOPT ; } \n\t\tboundary component def CoolerCP {\t \n\t\t  \t\tports : controllerC : CommandIPT ;\n\t\t  \t\t\t\tcoolerF : FTemperatureOPT ; }\n\t\tcomponent def PresenceCheckerCP {\t \n\t\t\tports : detected : PresenceIPT ; \n\t\t\t\t\tuserTemp : CTemperatureIPT ; \n\t\t\t\t\ttarget : CTemperatureOPT ;\n\t\t}\n\t\n\t\tcomponent def CommanderCP {\t \n\t\t\tports : target2 : CTemperatureIPT ; average2 : CTemperatureIPT ; heating : CommandOPT ; cooling : CommandOPT ;\n\t\t}\n\t\n\t\tcomponent def SensorsMonitorCP { \n\t\t\tports : s1 : CTemperatureIPT ; s2 : CTemperatureIPT ; s3 : CTemperatureIPT ; s4 : CTemperatureIPT ; average : CTemperatureOPT ;  } \n\t\t\n\t\tboundary component def AirTemperatureENV { ports : inTempF : FTemperatureIPT ; outTempF : FTemperatureOPT ;\n\t\t\t//property temperature : FahrenheitTemperature ;\n\t\t} \n\t\t\n\t\tboundary component def PersonENV { ports : outDesired : CTemperatureOPT ; outPresence : PresenceOPT ; }\n\t\t\n\t\tcomponent def RoomTemperatureENV { \n\t\t\tports : \n\t\t\t\trtIn1 : FTemperatureIPT ; \n\t\t\t\trtOut1 : FTemperatureOPT ; \n\t\t\t\trtIn2 : FTemperatureIPT ; \n\t\t\t\trtOut2 : FTemperatureOPT ; \n\t\t\t\trtIn3 : FTemperatureIPT ; \n\t\t\t\trtOut3 : FTemperatureOPT ; \n\t\t\t\trtIn4 : FTemperatureIPT ; \n\t\t\t\trtOut4 : FTemperatureOPT ; \n\t\t\tconfiguration { \n\t\t\t\tcomponents : \n\t\t\t\t\tat1 : AirTemperatureENV { \n\t\t\t\t\t\tusing ports : inTempF1 : FTemperatureIPT ; outTempF1 : FTemperatureOPT ;\n\t\t\t\t\t\t//property temperature = 75 ;\n\t\t\t\t\t} \n\t\t\t\t\tat2 : AirTemperatureENV { \n\t\t\t\t\t\tusing ports : inTempF2 : FTemperatureIPT ; outTempF2 : FTemperatureOPT ;\n\t\t\t\t\t\t//property temperature = 76 ;\n\t\t\t\t\t} \n\t\t\t\t\tat3 : AirTemperatureENV { \n\t\t\t\t\t\tusing ports : inTempF3 : FTemperatureIPT ; outTempF3 : FTemperatureOPT ;\n\t\t\t\t\t\t//property temperature = 78 ;\n\t\t\t\t\t} \n\t\t\t\t\tat4 : AirTemperatureENV { \n\t\t\t\t\t\tusing ports : inTempF4 : FTemperatureIPT ; outTempF4 : FTemperatureOPT ;\n\t\t\t\t\t\t//property temperature = 79 ;\n\t\t\t\t\t} \n\t\t\tdelegations : \n\t\t\t\tinTempF1 to rtIn1 \n\t\t\t\tinTempF2 to rtIn2 \n\t\t\t\tinTempF3 to rtIn3 \n\t\t\t\tinTempF4 to rtIn4 \t\t\t\t\n\t\t\t\toutTempF1 to rtOut1 \n\t\t\t\toutTempF2 to rtOut2 \n\t\t\t\toutTempF3 to rtOut3 \n\t\t\t\toutTempF4 to rtOut4 \n\t\t\t}\n\t\t} \n\t\t\t\n\t\tconstraint CalculateAverageTemperatureEQ ( t1 : CelsiusTemperature , t2 : CelsiusTemperature, t3 : CelsiusTemperature, t4 : CelsiusTemperature ) : ( av : CelsiusTemperature ) {\n\t\t\tequation = av == (t1 + t2 + t3 + t4)/4\n\t\t} \n\t\tactivity def CalculateAverageTemperatureAC ( s1 : CelsiusTemperature ) ( s2 : CelsiusTemperature ) ( s3 : CelsiusTemperature ) ( s4 : CelsiusTemperature ): ( average : CelsiusTemperature ) { \n\t\t\tbody { \n\t\t\t\tactions : CalcAvTemp : CalculateAverageTemperatureAN { \n\t\t\t\t\tusing pins : s1 : CelsiusTemperature ; \n\t\t\t\t\ts2 : CelsiusTemperature ;\n\t\t\t\t\ts3 : CelsiusTemperature ;\n\t\t\t\t\ts4 : CelsiusTemperature ;\n\t\t\t\t} \n\t\t\t\tdelegate s1 to s1 \n\t\t\t\tdelegate s2 to s2 \n\t\t\t\tdelegate s3 to s3 \n\t\t\t\tdelegate s4 to s4 \n\t\t\t\tdelegate average to CalcAvTemp\n\t\t\t}\n\t\t} \n\t\taction def CalculateAverageTemperatureAN ( t1 : CelsiusTemperature , t2 : CelsiusTemperature, t3 : CelsiusTemperature, t4 : CelsiusTemperature ) : CelsiusTemperature { \n\t\t\tconstraint : post-condition CalculateAverageTemperatureEQ\n\t\t} \n\t\tactivity def CheckPresenceToSetTemperatureAC ( detected : Boolean ) ( userTemp : CelsiusTemperature ) : ( target : CelsiusTemperature ) { \n\t\t\tbody { \n\t\t\t\tactions : CheckPeresenceToSetTemperatureAN : CheckPeresenceToSetTemperatureAN { \n\t\t\t\t\tusing pins : \n\t\t\t\t\t\tdetected : Boolean ; \n\t\t\t\t\t\tuserTemp : CelsiusTemperature ;\n\t\t\t\t} \n\t\t\t\tdelegate detected to detected \n\t\t\t\tdelegate userTemp to userTemp \n\t\t\t\tdelegate target to CheckPeresenceToSetTemperatureAN\n\t\t\t}\n\t\t} \n\t\tactivity def DecideCommandAC ( average2 : CelsiusTemperature ) ( target2 : CelsiusTemperature ) : ( cooling : Command , heating : Command ) { \n\t\t\tbody { \n\t\t\t\tactions : ct : CompareTemperatureAN { using pins : average2 : CelsiusTemperature ; target2 : CelsiusTemperature ; } cmdH : CommandHeaterAN { using pins : cmdsH : Commands ; } cmdC : CommandCoolerAN { using pins : cmdsC : Commands ; } delegate average2 to average2 delegate target2 to target2 delegate heating to cmdH delegate cooling to cmdC flow from ct to cmdsH flow from ct to cmdsC\n\t\t\t}\n\t\t} \n\t\tactivity def FahrenheitToCelsiusAC ( current1 : FahrenheitTemperature ) : ( loalTemp1 : CelsiusTemperature ) { \n\t\t\tbody { actions : FtC : FahrenheitToCelsiusAN { using pins : current1 : FahrenheitTemperature ; } delegate loalTemp1 to FtC delegate current1 to current1 }\n\t\t} \n\t\taction def CompareTemperatureAN (average2 : CelsiusTemperature , target2 : CelsiusTemperature) \n\t\t\t: Commands { \n\t\t\t\tconstraint : post-condition CompareTemperatureEQ \n\t\t\t} \n\t\taction def CommandHeaterAN ( cmds : Commands ) \n\t\t\t: Command { \n\t\t\t\tconstraint : post-condition CommandHeaterEQ\n\t\t\t} \n\t\taction def CommandCoolerAN ( cmds : Commands ) \n\t\t\t: Command { \n\t\t\t\tconstraint : post-condition CommandCoolerEQ\n\t\t\t} \n\t\tconstraint CompareTemperatureEQ ( target : CelsiusTemperature , average : CelsiusTemperature ) : ( cmds : Commands ) { \n\t\t\t\tequation = average > target ? cmds == types.Commands.heater->Off && types.Commands.cooler->On : types.Commands.heater->On && cmds == types.Commands.cooler->Off\n\t\t\t} \n\t\tconstraint FahrenheitToCelsiusEQ ( f : FahrenheitTemperature ) : ( c : CelsiusTemperature ) { \n\t\t\t\tequation = c == (5*(f - 32)/9)\n\t\t\t} \n\t\tconstraint CommandHeaterEQ ( cmds : Commands ) : ( c : Command ) { \n\t\t\t\tequation = c == cmds->heater \n\t\t\t} \n\t\tconstraint CommandCoolerEQ ( cmds : Commands ) : ( c : Command ) {equation = c == cmds->cooler } \n\t\taction def FahrenheitToCelsiusAN ( current1 : FahrenheitTemperature ) : CelsiusTemperature { constraint : post-condition FahrenheitToCelsiusEQ } \t\n\t\taction def CheckPeresenceToSetTemperatureAN ( detected : Boolean , userTemp : CelsiusTemperature ) : CelsiusTemperature { constraint : post-condition CheckPresenceToSetTemperatureEQ } \n\t\tconstraint CheckPresenceToSetTemperatureEQ ( detected : Boolean , userTemp : CelsiusTemperature ) : ( target : CelsiusTemperature ) {equation = detected == true ? target == userTemp : target == 22 } \n\t\texecutable def CommandCoolerEx(in cmds:Commands): out Command{return cmds->cooler ; } \n\t\texecutable def CommandHeaterEx(in cmds:Commands): out Command{return cmds->heater ; }\n\t\texecutable def FahrenheitToCelsiusEx(in f:FahrenheitTemperature): out CelsiusTemperature{return 5*(f - 32)/9 ; }\n\t\texecutable def CalculateAverageTemperatureEx(in temp1:CelsiusTemperature,in temp2:CelsiusTemperature,in temp3:CelsiusTemperature,in temp4:CelsiusTemperature):out CelsiusTemperature{return (temp1 + temp2 + temp3 + temp4)/4 ; }\n\t\texecutable def CheckPresenceToSetTemperature(in presence:Boolean, in userTemp:CelsiusTemperature):out CelsiusTemperature{if(presence == true) return userTemp; else return 22; }\n\t\texecutable def CompareTemperatureEx(in target:CelsiusTemperature, in average:CelsiusTemperature):out Commands{let heater:Command = types.Command::Off; let cooler:Command = types.Command::Off; if(average > target) {heater = types.Command::Off; cooler = types.Command::On ; } else {heater = types.Command::On; cooler = types.Command::Off ;} } \n\t\t\n\t\t\n\t\tactivity def EVENTPresenceSensorAC ( inDetect : Boolean ) : ( detected : Boolean ) { \n\t\t\tbody { \n\t\t\t\tactions : PresenceSensorAN : PresenceSensorAN { \n\t\t\t\t\tusing pins : inDetect : Boolean ;\n\t\t\t\t} \n\t\t\t\tdelegate inDetect to inDetect \n\t\t\t\tdelegate detected to PresenceSensorAN\n\t\t\t}\n\t\t} \n\t\taction def PresenceSensorAN ( inDetect : Boolean ) : Boolean { } \n\t\texecutable def PresenceSensorEx(in inDetect:Boolean):out CelsiusTemperature{return inDetect; }\n\t\t\n\t\t\n\t\t\n\t\tactivity def EVENTTemperatureSensorAC ( inCurrent : FahrenheitTemperature ) : ( current : FahrenheitTemperature ) { \n\t\t\tbody { \n\t\t\t\tactions : TemperatureSensorAN : TemperatureSensorAN { \n\t\t\t\t\tusing pins : inCurrent : FahrenheitTemperature ;\n\t\t\t\t} \n\t\t\t\tdelegate inCurrent to inCurrent \n\t\t\t\tdelegate current to TemperatureSensorAN\n\t\t\t}\n\t\t} \n\t\taction def TemperatureSensorAN ( inCurrent : FahrenheitTemperature ) : FahrenheitTemperature { } \n\t\texecutable def TemperatureSensorEx(in inCurrent:FahrenheitTemperature):out FahrenheitTemperature{return inCurrent; }\n\t\t\n\t\n\t\n\t\tactivity def EVENTUserInterfaceAC ( inDesired : CelsiusTemperature ) : ( desired : CelsiusTemperature ) { \n\t\t\tbody { \n\t\t\t\tactions : UserInterfaceAN : UserInterfaceAN { \n\t\t\t\t\tusing pins : inDesired : CelsiusTemperature ;\n\t\t\t\t} \n\t\t\t\tdelegate inDesired to inDesired \n\t\t\t\tdelegate desired to UserInterfaceAN\n\t\t\t}\n\t\t} \n\t\taction def UserInterfaceAN ( inDesired : CelsiusTemperature ) : CelsiusTemperature { } \n\t\texecutable def UserInterfaceEx(in inDesired : CelsiusTemperature):out CelsiusTemperature{return inDesired; }\n\t\t\n\t\t\n\t\tactivity def EVENTAirTemperatureAC ( inTempF : FahrenheitTemperature ) : ( outTempF : FahrenheitTemperature ) { \n\t\t\tbody { \n\t\t\t\tactions : AirTemperatureAN : AirTemperatureAN { \n\t\t\t\t\tusing pins : inTempF : FahrenheitTemperature ;\n\t\t\t\t} \n\t\t\t\tdelegate inTempF to inTempF \n\t\t\t\tdelegate outTempF to AirTemperatureAN\n\t\t\t}\n\t\t} \n\t\taction def AirTemperatureAN ( inTempF : FahrenheitTemperature ) : FahrenheitTemperature { } \n\t\texecutable def AirTemperatureEx(in inTempF : FahrenheitTemperature):out FahrenheitTemperature{return inTempF; }\n}\t\t\n\t\t\nallocations { \n\tactivity FahrenheitToCelsiusAC to FahrenheitToCelsiusCN \n\tactivity DecideCommandAC to CommanderCP \n\tactivity CheckPresenceToSetTemperatureAC to PresenceCheckerCP \n\tactivity CalculateAverageTemperatureAC to SensorsMonitorCP\n\t\n\tactivity EVENTPresenceSensorAC to PresenceSensorCP\n\tactivity EVENTTemperatureSensorAC to TemperatureSensorCP\n\tactivity EVENTUserInterfaceAC to UserInterfaceCP\n\tactivity EVENTAirTemperatureAC to AirTemperatureENV\n\t\n\texecutable FahrenheitToCelsiusEx to FahrenheitToCelsiusAN \n\texecutable CompareTemperatureEx to CompareTemperatureAN \n\texecutable CommandHeaterEx to CommandHeaterAN \n\texecutable CommandCoolerEx to CommandCoolerAN \n\texecutable CheckPresenceToSetTemperature to CheckPeresenceToSetTemperatureAN \n\texecutable CalculateAverageTemperatureEx to CalculateAverageTemperatureAN\n\n\texecutable PresenceSensorEx to PresenceSensorAN \n\texecutable TemperatureSensorEx to TemperatureSensorAN \n\texecutable UserInterfaceEx to UserInterfaceAN \n\texecutable AirTemperatureEx to AirTemperatureAN \n\t\n}"
            },
