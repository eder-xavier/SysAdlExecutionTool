            }
          }
        },
        {
          "type": "ComponentDef",
          "isBoundary": true,
          "name": "AirTemperatureENV",
          "appliedStyle": null,
          "abstractComponent": null,
          "ports": [
            {
              "type": "PortUse",
              "name": "inTempF",
              "definition": "FTemperatureIPT",
