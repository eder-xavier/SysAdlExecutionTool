            }
          }
        },
        {
          "type": "ActivityDef",
          "name": "EVENTTemperatureSensorAC",
          "implements": [],
          "inParameters": [
            [
              {
                "type": "Pin",
                "name": "inCurrent",
                "isFlow": false,
                "definition": "FahrenheitTemperature",
