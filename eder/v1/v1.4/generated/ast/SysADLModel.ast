      "importedDefinitions": [],
      "definitions": [
        {
          "type": "ComponentDef",
          "isBoundary": false,
          "name": "RTCSystemCFD",
          "appliedStyle": null,
          "abstractComponent": null,
          "ports": [],
          "members": [],
          "composite": {
