            }
          }
        },
        {
          "type": "ActivityDef",
          "name": "FahrenheitToCelsiusAC",
          "implements": [],
          "inParameters": [
            [
              {
                "type": "Pin",
                "name": "current1",
                "isFlow": false,
                "definition": "FahrenheitTemperature",
