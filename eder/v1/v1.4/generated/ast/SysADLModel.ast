            }
          }
        },
        {
          "type": "ComponentDef",
          "isBoundary": false,
          "name": "CommanderCP",
          "appliedStyle": null,
          "abstractComponent": null,
          "ports": [
            {
              "type": "PortUse",
              "name": "target2",
              "definition": "CTemperatureIPT",
              "concrete": null,
